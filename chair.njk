---
pagination:
  data: products.chairs
  size: 1
  alias: chair
permalink: "chairs/{{ chair.id }}/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🪑</text></svg>">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% set pageTitle = chair.identity.brand + " " + chair.identity.model + " Review — Ergonomic Chair for Back Pain | Ergely" %}
  {% set pageDesc = chair.editorial.best_for_summary %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://ergely.com/chairs/{{ chair.id }}/">
  <meta property="og:type" content="product">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="https://ergely.com/chairs/{{ chair.id }}/">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "{{ chair.identity.brand }} {{ chair.identity.model }}",
    "description": "{{ chair.editorial.best_for_summary }}",
    "brand": { "@type": "Brand", "name": "{{ chair.identity.brand }}" },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "USD",
      "price": "{{ chair.identity.price_usd }}",
      "availability": "https://schema.org/InStock",
      "url": "{{ chair.identity.product_url }}"
    }
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --black:    #1B1B1B;
      --accent:   #E05A2B;
      --white:    #FFFFFF;
      --offwhite: #F7F7F5;
      --border:   #E4E4E0;
      --muted:    #6B6B6B;
      --green:    #2A7D4F;
      --red:      #C0392B;
      --partial:  #B07D1A;
      --font:     'Inter', system-ui, sans-serif;
    }
    body { font-family: var(--font); background: var(--white); color: var(--black); font-size: 15px; line-height: 1.6; }
    a { color: inherit; text-decoration: none; }

    /* NAVBAR */
    nav { background: #ffffff; height: 56px; display: flex; align-items: center; padding: 0 32px; position: sticky; top: 0; z-index: 200; gap: 32px; border-bottom: 1px solid #e4e4e0; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    .logo { font-size: 19px; font-weight: 800; letter-spacing: -0.03em; color: #1B1B1B; flex-shrink: 0; }
    .logo span { color: #E05A2B; }
    .nav-links { display: flex; gap: 2px; flex: 1; }
    .nav-links a { color: #1B1B1B; font-size: 13px; font-weight: 500; padding: 5px 12px; border-radius: 5px; transition: color 0.12s, background 0.12s; white-space: nowrap; }
    .nav-links a:hover { color: #E05A2B; background: #fff5f2; }
    .nav-links a.active { color: #E05A2B; font-weight: 600; }
    .nav-links a.soon, .nav-links span.soon { color: #666666; pointer-events: none; padding: 5px 12px; font-size: 13px; font-weight: 500; }
    .nav-right { margin-left: auto; display: flex; align-items: center; gap: 8px; }
    .nav-right a { color: #6B6B6B; font-size: 13px; font-weight: 500; padding: 5px 12px; border-radius: 5px; transition: color 0.12s; }
    .nav-right a:hover { color: #1B1B1B; }
    .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 4px; margin-left: auto; background: none; border: none; }
    .hamburger span { display: block; width: 22px; height: 2px; background: #1B1B1B; border-radius: 2px; }
    .mobile-menu { display: none; position: fixed; top: 56px; left: 0; right: 0; background: #ffffff; border-bottom: 1px solid #E4E4E0; padding: 12px 0; z-index: 199; box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
    .mobile-menu.open { display: block; }
    .mobile-menu a { display: block; padding: 12px 24px; font-size: 15px; font-weight: 500; color: #1B1B1B; border-bottom: 1px solid #F7F7F5; }
    .mobile-menu a.active { color: #E05A2B; font-weight: 600; }
    .mobile-menu span.soon { color: #aaaaaa; pointer-events: none; display: block; padding: 12px 24px; font-size: 15px; font-weight: 500; border-bottom: 1px solid #F7F7F5; }

    /* BREADCRUMB */
    .breadcrumb { padding: 12px 32px; font-size: 13px; color: var(--muted); max-width: 1100px; margin: 0 auto; }
    .breadcrumb a { color: var(--muted); }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb span { margin: 0 6px; }

    /* LAYOUT */
    .product-page { max-width: 1100px; margin: 0 auto; padding: 24px 32px 64px; display: grid; grid-template-columns: 380px 1fr; gap: 48px; align-items: start; }

    /* LEFT */
    .product-gallery { position: sticky; top: 76px; }
    .product-image-wrap { background: var(--offwhite); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; }
    .product-image-wrap img { width: 100%; height: 100%; object-fit: contain; padding: 16px; }
    .img-placeholder { color: var(--muted); font-size: 13px; text-align: center; }
    .price-box { margin-top: 16px; padding: 18px; border: 1px solid var(--border); border-radius: 10px; background: var(--offwhite); }
    .price-label { font-size: 12px; color: var(--muted); margin-bottom: 4px; }
    .price-value { font-size: 28px; font-weight: 800; color: var(--black); letter-spacing: -0.02em; }
    .btn-primary { display: block; width: 100%; margin-top: 12px; padding: 13px 20px; background: var(--accent); color: #fff; font-weight: 600; font-size: 14px; text-align: center; border-radius: 7px; transition: background 0.12s; }
    .btn-primary:hover { background: #c44e24; }
    .key-specs-list { margin-top: 16px; list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .key-specs-list li { display: flex; justify-content: space-between; font-size: 13px; padding: 8px 12px; background: var(--offwhite); border: 1px solid var(--border); border-radius: 6px; }
    .spec-label { color: var(--muted); }
    .spec-val { font-weight: 600; }

    /* RIGHT */
    .product-content { min-width: 0; }
    .product-brand { font-size: 12px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; }
    h1.product-title { font-size: 26px; font-weight: 800; line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 10px; }
    .product-summary { font-size: 14px; color: var(--muted); margin-bottom: 20px; line-height: 1.65; }
    .tag-list { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 24px; }
    .tag { font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 99px; background: var(--offwhite); border: 1px solid var(--border); color: var(--black); text-transform: uppercase; letter-spacing: 0.05em; }

    /* FIT BOXES */
    .fit-boxes { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 28px; }
    .fit-box { padding: 16px; border-radius: 10px; font-size: 13px; line-height: 1.55; }
    .fit-box-good { background: #EAF4EE; border: 1px solid #A8D5B5; }
    .fit-box-poor { background: #FAEAEA; border: 1px solid #E8A8A8; }
    .fit-box-title { font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; }
    .fit-box-good .fit-box-title { color: var(--green); }
    .fit-box-poor .fit-box-title { color: var(--red); }

    /* FIT CALCULATOR */
    .fit-calculator { background: var(--offwhite); border: 1px solid var(--border); border-radius: 10px; padding: 20px; margin-bottom: 28px; }
    .fit-calculator h2 { font-size: 15px; font-weight: 700; margin-bottom: 14px; }
    .calc-inputs { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
    .calc-field { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 110px; }
    .calc-field label { font-size: 12px; color: var(--muted); font-weight: 500; }
    .calc-field input { padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; font-family: var(--font); background: #fff; width: 100%; }
    .calc-field input:focus { outline: 2px solid var(--accent); border-color: transparent; }
    .btn-calc { padding: 9px 20px; background: var(--accent); color: #fff; font-weight: 600; font-size: 13px; border: none; border-radius: 6px; cursor: pointer; font-family: var(--font); transition: background 0.12s; align-self: flex-end; }
    .btn-calc:hover { background: #c44e24; }
    .calc-result { display: none; margin-top: 12px; padding: 12px 14px; border-radius: 8px; font-size: 13px; line-height: 1.5; font-weight: 500; }
    .calc-result.good    { background: #EAF4EE; border: 1px solid #A8D5B5; color: var(--green); }
    .calc-result.partial { background: #FFF8E7; border: 1px solid #E0C96A; color: var(--partial); }
    .calc-result.poor    { background: #FAEAEA; border: 1px solid #E8A8A8; color: var(--red); }

    /* SPECS ACCORDION */
    .specs-section { margin-bottom: 28px; }
    .specs-section h2 { font-size: 16px; font-weight: 700; margin-bottom: 14px; }
    .accordion-item { border: 1px solid var(--border); border-radius: 8px; margin-bottom: 6px; overflow: hidden; }
    .accordion-header { width: 100%; background: var(--offwhite); border: none; padding: 13px 16px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-family: var(--font); font-size: 14px; font-weight: 600; color: var(--black); text-align: left; }
    .accordion-header:hover { background: #ececea; }
    .accordion-arrow { font-size: 11px; transition: transform 0.2s; color: var(--muted); }
    .accordion-header[aria-expanded="true"] .accordion-arrow { transform: rotate(180deg); }
    .accordion-body { display: none; padding: 14px 16px; background: #fff; }
    .accordion-body.open { display: block; }
    .spec-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .spec-table tr { border-bottom: 1px solid var(--border); }
    .spec-table tr:last-child { border-bottom: none; }
    .spec-table td { padding: 8px 4px; }
    .spec-table td:first-child { color: var(--muted); width: 55%; }
    .spec-table td:last-child { font-weight: 500; text-align: right; }

    /* RELATED */
    .related-section { margin-top: 40px; }
    .related-section h2 { font-size: 16px; font-weight: 700; margin-bottom: 14px; }
    .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .related-card { border: 1px solid var(--border); border-radius: 10px; padding: 14px; color: var(--black); transition: border-color 0.15s, box-shadow 0.15s; background: var(--offwhite); }
    .related-card:hover { border-color: var(--accent); box-shadow: 0 2px 12px rgba(224,90,43,0.1); }
    .related-card-brand { font-size: 11px; color: var(--muted); font-weight: 700; text-transform: uppercase; margin-bottom: 2px; }
    .related-card-model { font-weight: 700; font-size: 13px; margin-bottom: 5px; }
    .related-card-summary { font-size: 12px; color: var(--muted); line-height: 1.45; }

    /* FOOTER */
    footer { background: #111111; padding: 48px 32px 0; }
    .footer-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; padding-bottom: 48px; border-bottom: 1px solid #2a2a2a; }
    .footer-logo { font-size: 18px; font-weight: 800; letter-spacing: -0.03em; color: #ffffff; margin-bottom: 12px; display: block; }
    .footer-logo span { color: #E05A2B; }
    .footer-tagline { font-size: 13px; color: #999999; line-height: 1.6; margin-bottom: 16px; }
    .footer-copy { font-size: 12px; color: #666666; }
    .footer-col h4 { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #aaaaaa; margin-bottom: 16px; }
    .footer-col a { display: block; font-size: 13px; color: #999999; margin-bottom: 9px; transition: color 0.12s; }
    .footer-col a:hover { color: #ffffff; }
    .footer-col span.soon { color: #888888; pointer-events: none; display: block; font-size: 13px; margin-bottom: 9px; }
    .footer-bottom { max-width: 1100px; margin: 0 auto; padding: 18px 0; display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #666666; gap: 24px; }

    /* MOBILE */
    @media (max-width: 900px) {
      .product-page { grid-template-columns: 1fr; gap: 24px; padding: 16px 20px 48px; }
      .product-gallery { position: static; }
      .fit-boxes { grid-template-columns: 1fr; }
      .related-grid { grid-template-columns: 1fr; }
      h1.product-title { font-size: 22px; }
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    }
    @media (max-width: 600px) {
      nav { padding: 0 16px; }
      .nav-links { display: none; }
      .nav-right { display: none; }
      .hamburger { display: flex; }
      .footer-grid { grid-template-columns: 1fr; gap: 28px; }
      .footer-bottom { flex-direction: column; text-align: center; }
    }
  </style>
</head>
<body>

<nav>
  <a href="/" class="logo">Erge<span>ly</span></a>
  <div class="nav-links">
    <a href="/chairs/" class="active">Chairs</a>
    <span class="soon">Standing Desks</span>
    <span class="soon">Lumbar Supports</span>
    <span class="soon">Cushions</span>
    <span class="soon">Mattresses</span>
  </div>
  <div class="nav-right">
    <a href="/guides/">Guides</a>
    <a href="/tools/chair-size-finder/">Size Finder</a>
  </div>
  <button class="hamburger" onclick="toggleMenu()" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="mobile-menu" id="mobile-menu">
  <a href="/chairs/" class="active">Chairs</a>
  <span class="soon">Standing Desks</span>
  <span class="soon">Lumbar Supports</span>
  <span class="soon">Cushions</span>
  <span class="soon">Mattresses</span>
  <a href="/guides/">Guides</a>
  <a href="/tools/chair-size-finder/">Size Finder</a>
</div>

<div class="breadcrumb">
  <a href="/">Home</a><span>›</span>
  <a href="/chairs/">Chairs</a><span>›</span>
  {{ chair.identity.brand }} {{ chair.identity.model }}
</div>

<div class="product-page">

  <aside class="product-gallery">
    <div class="product-image-wrap">
      {% if chair.identity.image_url %}
        <img src="{{ chair.identity.image_url }}" alt="{{ chair.identity.brand }} {{ chair.identity.model }} ergonomic chair" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
        <div class="img-placeholder" style="display:none;">Image not available</div>
      {% else %}
        <div class="img-placeholder">Image coming soon</div>
      {% endif %}
    </div>
    <div class="price-box">
      <div class="price-label">Price (approx.)</div>
      <div class="price-value">{% if chair.identity.price_usd %}${{ chair.identity.price_usd }}{% else %}—{% endif %}</div>
      <a href="{{ chair.identity.product_url }}" target="_blank" rel="noopener sponsored" class="btn-primary">Check price at {{ chair.identity.brand }} →</a>
    </div>
    <ul class="key-specs-list">
      <li><span class="spec-label">Fits height</span><span class="spec-val">{% if chair.anthropometric_fit.user_height_min_cm and chair.anthropometric_fit.user_height_max_cm %}{{ chair.anthropometric_fit.user_height_min_cm }}–{{ chair.anthropometric_fit.user_height_max_cm }} cm{% else %}—{% endif %}</span></li>
      <li><span class="spec-label">Max weight</span><span class="spec-val">{% if chair.anthropometric_fit.weight_capacity_kg %}{{ chair.anthropometric_fit.weight_capacity_kg }} kg{% else %}—{% endif %}</span></li>
      <li><span class="spec-label">Seat material</span><span class="spec-val">{{ chair.seat.seat_material | replace("_", " ") | title if chair.seat.seat_material else "—" }}</span></li>
      <li><span class="spec-label">Armrests</span><span class="spec-val">{{ chair.armrests.armrest_type | upper if chair.armrests.armrest_type else "—" }}</span></li>
      <li><span class="spec-label">Headrest</span><span class="spec-val">{{ "Yes" if chair.headrest.headrest_present else "No" }}</span></li>
      <li><span class="spec-label">Warranty</span><span class="spec-val">{{ chair.build.warranty_years ~ " yr" if chair.build.warranty_years else "—" }}</span></li>
    </ul>
  </aside>

  <main class="product-content">
    <div class="product-brand">{{ chair.identity.brand }}</div>
    <h1 class="product-title">{{ chair.identity.model }}{% if chair.identity.variant %} — {{ chair.identity.variant }}{% endif %}</h1>
    <p class="product-summary">{{ chair.editorial.best_for_summary }}</p>

    {% if chair.editorial.tags %}
    <div class="tag-list">
      {% for tag in chair.editorial.tags %}<span class="tag">{{ tag | replace("_", " ") }}</span>{% endfor %}
    </div>
    {% endif %}

    <div class="fit-boxes">
      <div class="fit-box fit-box-good">
        <div class="fit-box-title">✓ Best for</div>
        {{ chair.editorial.best_for_summary }}
      </div>
      <div class="fit-box fit-box-poor">
        <div class="fit-box-title">✗ Not recommended for</div>
        {{ chair.editorial.not_recommended_for if chair.editorial.not_recommended_for else "No limitations noted." }}
      </div>
    </div>

    <div class="fit-calculator">
      <h2>Does this chair fit you?</h2>
      <div class="calc-inputs">
        <div class="calc-field">
          <label for="calc-height">Your height (cm)</label>
          <input type="number" id="calc-height" placeholder="e.g. 178" min="140" max="220">
        </div>
        <div class="calc-field">
          <label for="calc-weight">Your weight (kg)</label>
          <input type="number" id="calc-weight" placeholder="e.g. 80" min="40" max="200">
        </div>
        <button class="btn-calc" onclick="calcFit()">Check fit</button>
      </div>
      <div class="calc-result" id="calc-result"></div>
    </div>

    <div class="specs-section">
      <h2>Full specifications</h2>

      <div class="accordion-item">
        <button class="accordion-header" aria-expanded="true" onclick="toggleAcc(this)">Seat <span class="accordion-arrow">▼</span></button>
        <div class="accordion-body open">
          <table class="spec-table">
            <tr><td>Seat height range</td><td>{% if chair.seat.seat_height_min_cm and chair.seat.seat_height_max_cm %}{{ chair.seat.seat_height_min_cm }}–{{ chair.seat.seat_height_max_cm }} cm{% else %}—{% endif %}</td></tr>
            <tr><td>Seat depth range</td><td>{% if chair.seat.seat_depth_min_cm and chair.seat.seat_depth_max_cm %}{{ chair.seat.seat_depth_min_cm }}–{{ chair.seat.seat_depth_max_cm }} cm{% else %}—{% endif %}</td></tr>
            <tr><td>Seat depth adjustable</td><td>{{ "Yes" if chair.seat.seat_depth_adjustable else ("No" if chair.seat.seat_depth_adjustable == false else "—") }}</td></tr>
            <tr><td>Seat width</td><td>{{ chair.seat.seat_width_cm ~ " cm" if chair.seat.seat_width_cm else "—" }}</td></tr>
            <tr><td>Seat material</td><td>{{ chair.seat.seat_material | replace("_", " ") | title if chair.seat.seat_material else "—" }}</td></tr>
            <tr><td>Seat tilt</td><td>{{ "Yes" if chair.seat.seat_tilt else ("No" if chair.seat.seat_tilt == false else "—") }}</td></tr>
          </table>
        </div>
      </div>

      <div class="accordion-item">
        <button class="accordion-header" aria-expanded="false" onclick="toggleAcc(this)">Backrest <span class="accordion-arrow">▼</span></button>
        <div class="accordion-body">
          <table class="spec-table">
            <tr><td>Backrest height</td><td>{{ chair.backrest.backrest_height_cm ~ " cm" if chair.backrest.backrest_height_cm else "—" }}</td></tr>
            <tr><td>Backrest height adjustable</td><td>{{ "Yes" if chair.backrest.backrest_height_adjustable else ("No" if chair.backrest.backrest_height_adjustable == false else "—") }}</td></tr>
            <tr><td>Max recline</td><td>{{ chair.backrest.recline_max_deg ~ "°" if chair.backrest.recline_max_deg else "—" }}</td></tr>
            <tr><td>Recline lockable</td><td>{{ "Yes" if chair.backrest.recline_lockable else ("No" if chair.backrest.recline_lockable == false else "—") }}</td></tr>
            <tr><td>Recline positions</td><td>{{ chair.backrest.recline_positions if chair.backrest.recline_positions else "—" }}</td></tr>
            <tr><td>Backrest material</td><td>{{ chair.backrest.backrest_material | replace("_", " ") | title if chair.backrest.backrest_material else "—" }}</td></tr>
            <tr><td>Dynamic back</td><td>{{ "Yes" if chair.backrest.liveback_or_dynamic_back else ("No" if chair.backrest.liveback_or_dynamic_back == false else "—") }}</td></tr>
          </table>
        </div>
      </div>

      <div class="accordion-item">
        <button class="accordion-header" aria-expanded="false" onclick="toggleAcc(this)">Lumbar support <span class="accordion-arrow">▼</span></button>
        <div class="accordion-body">
          <table class="spec-table">
            <tr><td>Lumbar present</td><td>{{ "Yes" if chair.lumbar.lumbar_present else "No" }}</td></tr>
            <tr><td>Lumbar type</td><td>{{ chair.lumbar.lumbar_type | replace("_", " ") | title if chair.lumbar.lumbar_type else "—" }}</td></tr>
            <tr><td>Height adjustable</td><td>{{ "Yes" if chair.lumbar.lumbar_height_adjustable else ("No" if chair.lumbar.lumbar_height_adjustable == false else "—") }}</td></tr>
            <tr><td>Depth adjustable</td><td>{{ "Yes" if chair.lumbar.lumbar_depth_adjustable else ("No" if chair.lumbar.lumbar_depth_adjustable == false else "—") }}</td></tr>
            <tr><td>Dynamic lumbar</td><td>{{ "Yes" if chair.lumbar.lumbar_dynamic else ("No" if chair.lumbar.lumbar_dynamic == false else "—") }}</td></tr>
            {% if chair.lumbar.lumbar_notes %}<tr><td>Notes</td><td>{{ chair.lumbar.lumbar_notes }}</td></tr>{% endif %}
          </table>
        </div>
      </div>

      <div class="accordion-item">
        <button class="accordion-header" aria-expanded="false" onclick="toggleAcc(this)">Armrests <span class="accordion-arrow">▼</span></button>
        <div class="accordion-body">
          <table class="spec-table">
            <tr><td>Armrests present</td><td>{{ "Yes" if chair.armrests.armrest_present else "No" }}</td></tr>
            <tr><td>Armrest type</td><td>{{ chair.armrests.armrest_type | upper if chair.armrests.armrest_type else "—" }}</td></tr>
            <tr><td>Removable</td><td>{{ "Yes" if chair.armrests.armrests_removable else ("No" if chair.armrests.armrests_removable == false else "—") }}</td></tr>
          </table>
        </div>
      </div>

      <div class="accordion-item">
        <button class="accordion-header" aria-expanded="false" onclick="toggleAcc(this)">Headrest <span class="accordion-arrow">▼</span></button>
        <div class="accordion-body">
          <table class="spec-table">
            <tr><td>Headrest present</td><td>{{ "Yes" if chair.headrest.headrest_present else "No" }}</td></tr>
            {% if chair.headrest.headrest_present %}
            <tr><td>Adjustable</td><td>{{ "Yes" if chair.headrest.headrest_adjustable else "No" }}</td></tr>
            <tr><td>Adjustment axes</td><td>{{ chair.headrest.headrest_axes | join(", ") | title if chair.headrest.headrest_axes | length > 0 else "—" }}</td></tr>
            {% endif %}
          </table>
        </div>
      </div>

      <div class="accordion-item">
        <button class="accordion-header" aria-expanded="false" onclick="toggleAcc(this)">Build & certifications <span class="accordion-arrow">▼</span></button>
        <div class="accordion-body">
          <table class="spec-table">
            <tr><td>Frame material</td><td>{{ chair.build.frame_material | replace("_", " ") | title if chair.build.frame_material else "—" }}</td></tr>
            <tr><td>Base material</td><td>{{ chair.build.base_material | replace("_", " ") | title if chair.build.base_material else "—" }}</td></tr>
            <tr><td>Certifications</td><td>{{ chair.build.certifications | join(", ") if chair.build.certifications | length > 0 else "None published" }}</td></tr>
            <tr><td>Warranty</td><td>{{ chair.build.warranty_years ~ " years" if chair.build.warranty_years else "—" }}</td></tr>
          </table>
        </div>
      </div>
    </div>

    <div class="related-section">
      <h2>Similar chairs</h2>
      <div class="related-grid">
        {% set relatedCount = 0 %}
        {% for other in products.chairs %}
          {% if other.id != chair.id and relatedCount < 3 %}
            {% for need in chair.seo.primary_need %}
              {% if need in other.seo.primary_need and relatedCount < 3 %}
                <a href="/chairs/{{ other.id }}/" class="related-card">
                  <div class="related-card-brand">{{ other.identity.brand }}</div>
                  <div class="related-card-model">{{ other.identity.model }}</div>
                  <div class="related-card-summary">{{ other.editorial.best_for_summary }}</div>
                </a>
                {% set relatedCount = relatedCount + 1 %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </main>
</div>

