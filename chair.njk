<script>
  function toggleMenu() {
    document.getElementById('mobile-menu').classList.toggle('open');
  }
  document.addEventListener('click', function(e) {
    const menu = document.getElementById('mobile-menu');
    const hamburger = document.querySelector('.hamburger');
    if (!menu.contains(e.target) && !hamburger.contains(e.target)) menu.classList.remove('open');
  });
  function toggleAcc(btn) {
    const body = btn.nextElementSibling;
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isOpen));
    body.classList.toggle('open', !isOpen);
  }
  const CHAIR = {
    heightMin: {{ chair.anthropometric_fit.user_height_min_cm if chair.anthropometric_fit.user_height_min_cm else 'null' }},
    heightMax: {{ chair.anthropometric_fit.user_height_max_cm if chair.anthropometric_fit.user_height_max_cm else 'null' }},
    weightMax: {{ chair.anthropometric_fit.weight_capacity_kg if chair.anthropometric_fit.weight_capacity_kg else 'null' }}
  };
  (function() {
    const p = new URLSearchParams(window.location.search);
    const h = p.get('h'), w = p.get('w');
    if (h) document.getElementById('calc-height').value = h;
    if (w) document.getElementById('calc-weight').value = w;
    if (h || w) calcFit();
  })();
  function calcFit() {
    const h = parseFloat(document.getElementById('calc-height').value);
    const w = parseFloat(document.getElementById('calc-weight').value);
    const result = document.getElementById('calc-result');
    if (!h && !w) { result.style.display = 'none'; return; }
    let heightFit = null, weightFit = null;
    if (CHAIR.heightMin && CHAIR.heightMax && h) {
      if (h >= CHAIR.heightMin && h <= CHAIR.heightMax) heightFit = 'good';
      else if (Math.abs(h - CHAIR.heightMin) <= 5 || Math.abs(h - CHAIR.heightMax) <= 5) heightFit = 'partial';
      else heightFit = 'poor';
    } else { heightFit = h ? 'unknown' : null; }
    if (CHAIR.weightMax && w) weightFit = w <= CHAIR.weightMax ? 'good' : 'poor';
    else weightFit = w ? 'unknown' : null;
    const fits = [heightFit, weightFit].filter(Boolean);
    let verdict, cls, msg = '';
    if (fits.includes('poor')) { verdict = 'Poor fit'; cls = 'poor'; }
    else if (fits.includes('partial') || fits.includes('unknown')) { verdict = 'Partial fit'; cls = 'partial'; }
    else if (fits.length > 0) { verdict = 'Good fit'; cls = 'good'; }
    else { result.style.display = 'none'; return; }
    if (h) {
      if (CHAIR.heightMin && CHAIR.heightMax) msg += `Your height (${h} cm) ${heightFit === 'good' ? 'falls within' : heightFit === 'partial' ? 'is just outside' : 'is outside'} this chair's supported range of ${CHAIR.heightMin}–${CHAIR.heightMax} cm. `;
      else msg += `No height range published for this chair. `;
    }
    if (w) {
      if (CHAIR.weightMax) msg += `Your weight (${w} kg) is ${weightFit === 'good' ? 'within' : 'above'} the ${CHAIR.weightMax} kg capacity.`;
      else msg += `No weight capacity published for this chair.`;
    }
    result.className = `calc-result ${cls}`;
    result.innerHTML = `<strong>${verdict}.</strong> ${msg}`;
    result.style.display = 'block';
  }
</script>
</body>
</html>
