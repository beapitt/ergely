<script>
  // ── STATE ──
  const state = {
    height: null,
    weight: null,
    budget: null,
    need: null,
    material: null,
    headrest: false,
    depth: false,
    lumbar: false
  };

  // ── NAVBAR ──
  function toggleMenu() {
    document.getElementById('mobile-menu').classList.toggle('open');
  }
  document.addEventListener('click', function(e) {
    const menu = document.getElementById('mobile-menu');
    const hamburger = document.querySelector('.hamburger');
    if (menu && hamburger && !menu.contains(e.target) && !hamburger.contains(e.target)) {
      menu.classList.remove('open');
    }
  });

  // ── FILTER ACCORDION ──
  function toggleFilter(btn) {
    const body = btn.nextElementSibling;
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isOpen));
    body.classList.toggle('hidden', isOpen);
  }

  // ── PILLS ──
  function togglePill(btn, type) {
    const group = btn.closest('.pill-group');
    const wasActive = btn.classList.contains('active');
    group.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
    if (!wasActive) {
      btn.classList.add('active');
      state[type] = btn.dataset.value;
    } else {
      state[type] = null;
    }
    applyFilters();
  }

  // ── FIT FINDER ──
  function applyFitFinder() {
    const h = parseFloat(document.getElementById('ff-height').value);
    const w = parseFloat(document.getElementById('ff-weight').value);
    state.height = h || null;
    state.weight = w || null;

    const cards = document.querySelectorAll('.product-card');
    let goodCount = 0, partialCount = 0;

    cards.forEach(card => {
      const hMin = parseFloat(card.dataset.heightMin);
      const hMax = parseFloat(card.dataset.heightMax);
      const wMax = parseFloat(card.dataset.weightMax);
      const badge = document.getElementById('badge-' + card.dataset.id);

      if (!badge) return;

      let heightFit = null, weightFit = null;

      if (h && hMin && hMax) {
        if (h >= hMin && h <= hMax) heightFit = 'good';
        else if (Math.abs(h - hMin) <= 5 || Math.abs(h - hMax) <= 5) heightFit = 'partial';
        else heightFit = 'poor';
      }

      if (w && wMax) {
        weightFit = w <= wMax ? 'good' : 'poor';
      }

      const fits = [heightFit, weightFit].filter(Boolean);
      badge.className = 'fit-badge';

      if (fits.includes('poor')) {
        badge.textContent = 'Poor fit';
        badge.classList.add('poor');
        card.dataset.fitScore = '0';
      } else if (fits.includes('partial')) {
        badge.textContent = 'Partial fit';
        badge.classList.add('partial');
        card.dataset.fitScore = '1';
        partialCount++;
      } else if (fits.length > 0) {
        badge.textContent = 'Good fit';
        badge.classList.add('good');
        card.dataset.fitScore = '2';
        goodCount++;
      } else {
        card.dataset.fitScore = '1';
      }
    });

    // Update all card links to pass h and w as URL params
    document.querySelectorAll('.product-card').forEach(card => {
      const base = card.getAttribute('href').split('?')[0];
      const params = [];
      if (h) params.push('h=' + h);
      if (w) params.push('w=' + w);
      card.setAttribute('href', base + (params.length ? '?' + params.join('&') : ''));
    });

    const result = document.getElementById('ff-result');
    if (h || w) {
      result.textContent = `${goodCount} good fit, ${partialCount} partial fit found.`;
      result.classList.add('active');
    }

    applyFilters();
  }

  // ── MAIN FILTER FUNCTION ──
  function applyFilters() {
    state.headrest = document.getElementById('tog-headrest').checked;
    state.depth    = document.getElementById('tog-depth').checked;
    state.lumbar   = document.getElementById('tog-lumbar').checked;

    const cards = document.querySelectorAll('.product-card');
    let visible = 0;

    cards.forEach(card => {
      let show = true;

      if (state.budget && card.dataset.budget !== state.budget) show = false;

      if (state.need) {
        const needs = card.dataset.need.split(',');
        if (!needs.includes(state.need)) show = false;
      }

      if (state.material && card.dataset.material !== state.material) show = false;
      if (state.headrest && card.dataset.headrest !== 'true') show = false;
      if (state.depth    && card.dataset.depth    !== 'true') show = false;
      if (state.lumbar   && card.dataset.lumbar   !== 'true') show = false;

      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    document.getElementById('count').textContent = visible;
    const noResults = document.getElementById('no-results');
    noResults.classList.toggle('visible', visible === 0);
  }

  // ── SORT ──
  function applySort(value) {
    const grid = document.getElementById('product-grid');
    const cards = Array.from(grid.querySelectorAll('.product-card'));

    cards.sort((a, b) => {
      if (value === 'price_asc')  return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
      if (value === 'price_desc') return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
      return 0;
    });

    cards.forEach(card => grid.appendChild(card));
  }

  // ── RESET ──
  function resetAll() {
    state.height = null;
    state.weight = null;
    state.budget = null;
    state.need   = null;
    state.material = null;

    document.getElementById('ff-height').value = '';
    document.getElementById('ff-weight').value = '';
    document.getElementById('ff-result').classList.remove('active');
    document.getElementById('tog-headrest').checked = false;
    document.getElementById('tog-depth').checked    = false;
    document.getElementById('tog-lumbar').checked   = false;

    document.querySelectorAll('.pill.active').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.fit-badge').forEach(b => { b.className = 'fit-badge'; b.textContent = ''; });
    document.querySelectorAll('.product-card').forEach(c => { c.classList.remove('hidden'); delete c.dataset.fitScore; });

    document.getElementById('count').textContent = document.querySelectorAll('.product-card').length;
    document.getElementById('no-results').classList.remove('visible');
  }
</script>
</body>
