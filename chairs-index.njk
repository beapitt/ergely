---
permalink: "chairs/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ergonomic Chairs for Back Pain — Filter by Height, Weight & Budget | Ergely</title>
  <meta name="description" content="Find the right ergonomic chair for your body. Filter by height, weight, budget, brand and features. Verified specs, no sponsored rankings.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://ergely.com/chairs/">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Ergonomic Chairs for Back Pain",
    "url": "https://ergely.com/chairs/",
    "itemListElement": [
      {% for chair in products.chairs %}
      { "@type": "ListItem", "position": {{ loop.index }}, "name": "{{ chair.identity.brand }} {{ chair.identity.model }}", "url": "https://ergely.com/chairs/{{ chair.id }}/" }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --black:#1B1B1B;--accent:#E05A2B;--white:#FFFFFF;--offwhite:#F7F7F5;--border:#E4E4E0;--muted:#6B6B6B;--green:#2A7D4F;--red:#C0392B;--partial:#B07D1A;--font:'Inter',system-ui,sans-serif; }
    body { font-family:var(--font);background:var(--white);color:var(--black);font-size:15px;line-height:1.6; }
    a { color:inherit;text-decoration:none; }
    nav { background:#fff;height:56px;display:flex;align-items:center;padding:0 32px;position:sticky;top:0;z-index:200;gap:32px;border-bottom:1px solid #e4e4e0;box-shadow:0 1px 4px rgba(0,0,0,0.06); }
    .logo { font-size:19px;font-weight:800;letter-spacing:-0.03em;color:#1B1B1B;flex-shrink:0; }
    .logo span { color:#E05A2B; }
    .nav-links { display:flex;gap:2px;flex:1; }
    .nav-links a { color:#1B1B1B;font-size:13px;font-weight:500;padding:5px 12px;border-radius:5px;transition:color 0.12s,background 0.12s;white-space:nowrap; }
    .nav-links a:hover { color:#E05A2B;background:#fff5f2; }
    .nav-links a.active { color:#E05A2B;font-weight:600; }
    .nav-links span.soon { color:#666;pointer-events:none;padding:5px 12px;font-size:13px;font-weight:500; }
    .nav-right { margin-left:auto;display:flex;gap:8px; }
    .nav-right a { color:#6B6B6B;font-size:13px;font-weight:500;padding:5px 12px;border-radius:5px; }
    .nav-right a:hover { color:#1B1B1B; }
    .hamburger { display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;margin-left:auto;background:none;border:none; }
    .hamburger span { display:block;width:22px;height:2px;background:#1B1B1B;border-radius:2px; }
    .mobile-menu { display:none;position:fixed;top:56px;left:0;right:0;background:#fff;border-bottom:1px solid #E4E4E0;padding:12px 0;z-index:199;box-shadow:0 4px 16px rgba(0,0,0,0.08); }
    .mobile-menu.open { display:block; }
    .mobile-menu a { display:block;padding:12px 24px;font-size:15px;font-weight:500;color:#1B1B1B;border-bottom:1px solid #F7F7F5; }
    .mobile-menu a.active { color:#E05A2B;font-weight:600; }
    .page-header { background:var(--offwhite);border-bottom:1px solid var(--border);padding:28px 32px; }
    .page-header-inner { max-width:1100px;margin:0 auto; }
    .page-header h1 { font-size:22px;font-weight:800;letter-spacing:-0.02em;margin-bottom:4px; }
    .page-header p { font-size:13px;color:var(--muted); }
    .listing-wrap { max-width:1100px;margin:0 auto;padding:28px 32px 64px;display:grid;grid-template-columns:260px 1fr;gap:32px;align-items:start; }
    .sidebar { position:sticky;top:76px;display:flex;flex-direction:column;gap:6px; }
    .fit-finder { background:#fff8f5;border:1.5px solid #f0c4b0;border-radius:10px;padding:16px;margin-bottom:8px; }
    .fit-finder-title { font-size:13px;font-weight:700;color:var(--black);margin-bottom:12px; }
    .fit-finder-inputs { display:flex;flex-direction:column;gap:8px;margin-bottom:12px; }
    .fit-finder-field { display:flex;flex-direction:column;gap:3px; }
    .fit-finder-field label { font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em; }
    .fit-finder-field input { padding:8px 10px;border:1px solid var(--border);border-radius:6px;font-size:14px;font-family:var(--font);background:#fff;width:100%; }
    .fit-finder-field input:focus { outline:2px solid var(--accent);border-color:transparent; }
    .btn-find { width:100%;padding:10px;background:var(--accent);color:#fff;font-weight:700;font-size:13px;border:none;border-radius:6px;cursor:pointer;font-family:var(--font);transition:background 0.12s; }
    .btn-find:hover { background:#c44e24; }
    .fit-finder-result { display:none;margin-top:10px;font-size:12px;color:var(--muted); }
    .fit-finder-result.active { display:block; }
    .filter-section { border:1px solid var(--border);border-radius:10px;overflow:hidden; }
    .filter-header { padding:12px 14px;background:var(--offwhite);font-size:12px;font-weight:700;color:var(--black);text-transform:uppercase;letter-spacing:0.07em;display:flex;justify-content:space-between;align-items:center;cursor:pointer;border:none;width:100%;font-family:var(--font); }
    .filter-header:hover { background:#ececea; }
    .filter-arrow { font-size:10px;color:var(--muted);transition:transform 0.2s; }
    .filter-header[aria-expanded="false"] .filter-arrow { transform:rotate(-90deg); }
    .filter-body { padding:12px 14px;background:#fff; }
    .filter-body.hidden { display:none; }
    .pill-group { display:flex;flex-wrap:wrap;gap:6px; }
    .pill { font-size:12px;font-weight:500;padding:5px 11px;border-radius:99px;border:1px solid var(--border);background:#fff;color:var(--black);cursor:pointer;transition:all 0.12s;font-family:var(--font); }
    .pill:hover { border-color:var(--accent);color:var(--accent); }
    .pill.active { background:var(--accent);border-color:var(--accent);color:#fff; }
    .toggle-group { display:flex;flex-direction:column;gap:8px; }
    .toggle-item { display:flex;align-items:center;justify-content:space-between;font-size:13px; }
    .toggle-switch { position:relative;width:36px;height:20px; }
    .toggle-switch input { opacity:0;width:0;height:0; }
    .toggle-track { position:absolute;inset:0;background:var(--border);border-radius:99px;transition:background 0.2s;cursor:pointer; }
    .toggle-switch input:checked + .toggle-track { background:var(--accent); }
    .toggle-track::after { content:'';position:absolute;width:14px;height:14px;background:#fff;border-radius:50%;top:3px;left:3px;transition:transform 0.2s; }
    .toggle-switch input:checked + .toggle-track::after { transform:translateX(16px); }
    .reset-btn { font-size:12px;color:var(--muted);background:none;border:none;cursor:pointer;font-family:var(--font);padding:4px 0;text-decoration:underline; }
    .reset-btn:hover { color:var(--accent); }
    .results-area { min-width:0; }
    .results-bar { display:flex;align-items:center;justify-content:space-between;margin-bottom:20px; }
    .results-count { font-size:13px;color:var(--muted); }
    .results-count strong { color:var(--black); }
    .sort-select { font-size:13px;font-family:var(--font);padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:#fff;cursor:pointer; }
    .product-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:16px; }
    .product-card { border:1px solid var(--border);border-radius:10px;overflow:hidden;background:#fff;transition:border-color 0.15s,box-shadow 0.15s,transform 0.12s;display:flex;flex-direction:column; }
    .product-card:hover { border-color:var(--accent);box-shadow:0 4px 16px rgba(224,90,43,0.1);transform:translateY(-2px); }
    .product-card.hidden { display:none; }
    .card-image { aspect-ratio:4/3;background:#ffffff;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative;border-bottom:1px solid var(--border); }
    .card-image img { width:100%;height:100%;object-fit:cover; }
    .card-image .no-image { font-size:11px;color:var(--muted); }
    .fit-badge { position:absolute;bottom:8px;right:8px;display:none;flex-direction:column;align-items:center;border-radius:8px;padding:5px 8px;min-width:64px;text-align:center;box-shadow:0 2px 6px rgba(0,0,0,0.12); }
    .fit-badge.visible { display:flex; }
    .fit-badge-score { font-size:14px;font-weight:800;line-height:1;letter-spacing:-0.02em; }
    .fit-badge-match { font-size:9px;font-weight:600;margin-top:2px;line-height:1.2; }
    .fit-badge.excellent { background:#EAF4EE;color:#1E6B3A;border:1px solid #A8D5B5; }
    .fit-badge.good-match { background:#E8F4FF;color:#1A5FA8;border:1px solid #A8CBF0; }
    .fit-badge.fair { background:#FFF8E7;color:#8A6000;border:1px solid #E0C96A; }
    .fit-badge.limited { background:#FAEAEA;color:#9B2020;border:1px solid #E8A8A8; }
    .fit-score-header { display:none;margin-bottom:16px;padding:12px 16px;background:#F7F7F5;border-radius:8px;border:1px solid #E4E4E0; }
    .fit-score-header.visible { display:block; }
    .fit-score-header-title { font-size:13px;font-weight:700;color:#1B1B1B; }
    .fit-score-header-sub { font-size:12px;color:#6B6B6B;margin-top:2px; }
    .card-body { padding:14px;flex:1;display:flex;flex-direction:column;gap:6px; }
    .card-brand { font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em; }
    .card-model { font-size:14px;font-weight:700;color:var(--black);line-height:1.3; }
    .card-summary { font-size:12px;color:var(--muted);line-height:1.45;flex:1; }
    .card-fit-range { font-size:11px;color:var(--muted);font-weight:500; }
    .card-footer { padding:12px 14px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between; }
    .card-price { font-size:15px;font-weight:800;letter-spacing:-0.02em; }
    .card-cta { font-size:12px;font-weight:600;color:var(--accent); }
    .card-cta:hover { text-decoration:underline; }
    .no-results { display:none;text-align:center;padding:48px 24px;color:var(--muted); }
    .no-results.visible { display:block; }
    .no-results h3 { font-size:16px;font-weight:700;color:var(--black);margin-bottom:8px; }
    footer { background:#111;padding:48px 32px 0; }
    .footer-grid { max-width:1100px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px;padding-bottom:48px;border-bottom:1px solid #2a2a2a; }
    .footer-logo { font-size:18px;font-weight:800;color:#fff;margin-bottom:12px;display:block; }
    .footer-logo span { color:#E05A2B; }
    .footer-tagline { font-size:13px;color:#999;line-height:1.6;margin-bottom:16px; }
    .footer-copy { font-size:12px;color:#666; }
    .footer-col h4 { font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#aaa;margin-bottom:16px; }
    .footer-col a { display:block;font-size:13px;color:#999;margin-bottom:9px;transition:color 0.12s; }
    .footer-col a:hover { color:#fff; }
    .footer-bottom { max-width:1100px;margin:0 auto;padding:18px 0;display:flex;justify-content:space-between;font-size:12px;color:#666;gap:24px; }
    @media (max-width:900px) { .listing-wrap { grid-template-columns:1fr;gap:20px;padding:20px 20px 48px; } .sidebar { position:static; } .product-grid { grid-template-columns:repeat(2,1fr); } .footer-grid { grid-template-columns:1fr 1fr;gap:32px; } }
    @media (max-width:600px) { nav { padding:0 16px; } .nav-links,.nav-right { display:none; } .hamburger { display:flex; } .product-grid { grid-template-columns:1fr; } .footer-grid { grid-template-columns:1fr;gap:28px; } .footer-bottom { flex-direction:column;text-align:center; } }
  </style>
</head>
<body>
<nav>
  <a href="/" class="logo">Erge<span>ly</span></a>
  <div class="nav-links">
    <a href="/chairs/" class="active">Ergonomic Chairs</a>
    <a href="/kneeling-chairs/">Kneeling Chairs</a>
    <a href="/saddle-chairs/">Saddle Chairs</a>
    <a href="/gaming-chairs/">Gaming Chairs</a>
  </div>
  <div class="nav-right"><a href="/guides/">Guides</a><a href="/tools/chair-size-finder/">Size Finder</a></div>
  <button class="hamburger" onclick="toggleMenu()" aria-label="Menu"><span></span><span></span><span></span></button>
</nav>
<div class="mobile-menu" id="mobile-menu">
  <a href="/chairs/" class="active">Ergonomic Chairs</a>
  <a href="/kneeling-chairs/">Kneeling Chairs</a>
  <a href="/saddle-chairs/">Saddle Chairs</a>
  <a href="/gaming-chairs/">Gaming Chairs</a>
</div>

<div class="page-header">
  <div class="page-header-inner">
    <h1>Ergonomic Chairs for Back Pain</h1>
    <p>{{ products.chairs | length }} chairs with verified specs — filter by your body and needs</p>
  </div>
</div>

<div class="listing-wrap">
  <aside class="sidebar">
    <div class="fit-finder">
      <div class="fit-finder-title">Find the right chair for you</div>
      <div class="fit-finder-inputs">
        <div class="fit-finder-field">
          <label for="ff-height">Your height (cm)</label>
          <input type="number" id="ff-height" placeholder="e.g. 178" min="140" max="220">
        </div>
        <div class="fit-finder-field">
          <label for="ff-weight">Your weight (kg)</label>
          <input type="number" id="ff-weight" placeholder="e.g. 80" min="40" max="200">
        </div>
      </div>
      <button class="btn-find" onclick="applyFitFinder()">Find chairs</button>
      <div class="fit-finder-result" id="ff-result"></div>
    </div>
    <button class="reset-btn" onclick="resetAll()">Reset all filters</button>

    <div class="filter-section">
      <button class="filter-header" aria-expanded="true" onclick="toggleFilter(this)">Brand <span class="filter-arrow">▼</span></button>
      <div class="filter-body">
        <div class="pill-group" id="filter-brand">
          {% set brands = [] %}
          {% for chair in products.chairs %}
            {% if chair.identity.brand not in brands %}
              {% set brands = brands.concat([chair.identity.brand]) %}
              <button class="pill" data-value="{{ chair.identity.brand }}" onclick="togglePill(this,'brand')">{{ chair.identity.brand }}</button>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="filter-section">
      <button class="filter-header" aria-expanded="true" onclick="toggleFilter(this)">Budget <span class="filter-arrow">▼</span></button>
      <div class="filter-body">
        <div class="pill-group">
          <button class="pill" data-value="under_300" onclick="togglePill(this,'budget')">Under $300</button>
          <button class="pill" data-value="300_600" onclick="togglePill(this,'budget')">$300–$600</button>
          <button class="pill" data-value="600_1000" onclick="togglePill(this,'budget')">$600–$1000</button>
          <button class="pill" data-value="over_1000" onclick="togglePill(this,'budget')">$1000+</button>
        </div>
      </div>
    </div>

    <div class="filter-section">
      <button class="filter-header" aria-expanded="true" onclick="toggleFilter(this)">Seat material <span class="filter-arrow">▼</span></button>
      <div class="filter-body">
        <div class="pill-group">
          <button class="pill" data-value="mesh" onclick="togglePill(this,'material')">Mesh</button>
          <button class="pill" data-value="fabric" onclick="togglePill(this,'material')">Fabric</button>
          <button class="pill" data-value="leather" onclick="togglePill(this,'material')">Leather</button>
          <button class="pill" data-value="foam" onclick="togglePill(this,'material')">Foam</button>
        </div>
      </div>
    </div>

    <div class="filter-section">
      <button class="filter-header" aria-expanded="true" onclick="toggleFilter(this)">Features <span class="filter-arrow">▼</span></button>
      <div class="filter-body">
        <div class="toggle-group">
          <div class="toggle-item">
            <label for="tog-headrest">Headrest</label>
            <label class="toggle-switch"><input type="checkbox" id="tog-headrest" onchange="applyFilters()"><span class="toggle-track"></span></label>
          </div>
          <div class="toggle-item">
            <label for="tog-depth">Adjustable seat depth</label>
            <label class="toggle-switch"><input type="checkbox" id="tog-depth" onchange="applyFilters()"><span class="toggle-track"></span></label>
          </div>
          <div class="toggle-item">
            <label for="tog-tilt">Forward seat tilt</label>
            <label class="toggle-switch"><input type="checkbox" id="tog-tilt" onchange="applyFilters()"><span class="toggle-track"></span></label>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <div class="results-area">
    <div class="results-bar">
      <div class="results-count"><strong id="count">{{ products.chairs | length }}</strong> chairs found</div>
      <select class="sort-select" onchange="applySort(this.value)">
        <option value="default">Sort: Relevance</option>
        <option value="price_asc">Price: Low → High</option>
        <option value="price_desc">Price: High → Low</option>
      </select>
    </div>

    <div class="fit-score-header" id="fit-score-header"><div class="fit-score-header-title">Your Ergely Fit Scores™</div><div class="fit-score-header-sub" id="fit-score-sub"></div></div>
    <div class="product-grid" id="product-grid">
      {% for chair in products.chairs %}
      <a href="/chairs/{{ chair.id }}/"
         class="product-card"
         data-id="{{ chair.id }}"
         data-brand="{{ chair.identity.brand }}"
         data-budget="{{ chair.identity.price_range }}"
         data-price="{{ chair.identity.price_usd if chair.identity.price_usd else 0 }}"
         data-material="{{ chair.seat.seat_material | lower if chair.seat.seat_material else '' }}"
         data-headrest="{{ 'true' if chair.headrest.headrest_present else 'false' }}"
         data-depth="{{ 'true' if chair.seat.seat_depth_adjustable else 'false' }}"
         data-tilt="{{ 'true' if chair.seat.forward_seat_tilt else 'false' }}"
         data-height-min="{{ chair.anthropometric_fit.user_height_min_cm if chair.anthropometric_fit.user_height_min_cm else '' }}"
         data-height-max="{{ chair.anthropometric_fit.user_height_max_cm if chair.anthropometric_fit.user_height_max_cm else '' }}"
         data-weight-max="{{ chair.anthropometric_fit.weight_capacity_kg if chair.anthropometric_fit.weight_capacity_kg else '' }}"
         data-seat-min="{{ chair.seat.seat_height_min_cm if chair.seat.seat_height_min_cm else '' }}"
         data-seat-max="{{ chair.seat.seat_height_max_cm if chair.seat.seat_height_max_cm else '' }}"
         data-lumbar="{{ 'adjustable' if chair.lumbar.lumbar_depth_adjustable or chair.lumbar.lumbar_height_adjustable else ('present' if chair.lumbar.lumbar_present else 'none') }}"
         data-armrest="{{ chair.armrests.armrest_type if chair.armrests.armrest_type else 'none' }}"
      >
        <div class="card-image">
          {% if chair.identity.image_url %}
            <img src="{{ chair.identity.image_url }}" alt="{{ chair.identity.brand }} {{ chair.identity.model }}" loading="lazy" onerror="this.style.display='none'">
          {% else %}
            <div class="no-image">Image coming soon</div>
          {% endif %}
          <span class="fit-badge" id="badge-{{ chair.id }}"></span>
        </div>
        <div class="card-body">
          <div class="card-brand">{{ chair.identity.brand }}</div>
          <div class="card-model">{{ chair.identity.model }}</div>
          <div class="card-summary">{{ chair.editorial.best_for_summary }}</div>
          {% if chair.anthropometric_fit.user_height_min_cm and chair.anthropometric_fit.user_height_max_cm %}
          <div class="card-fit-range">Fits {{ chair.anthropometric_fit.user_height_min_cm }}–{{ chair.anthropometric_fit.user_height_max_cm }} cm</div>
          {% endif %}
        </div>
        <div class="card-footer">
          <div class="card-price">{% if chair.identity.price_usd %}${{ chair.identity.price_usd }}{% else %}—{% endif %}</div>
          <span class="card-cta">View chair →</span>
        </div>
      </a>
      {% endfor %}
    </div>
    <div class="no-results" id="no-results"><h3>No chairs match your filters</h3><p>Try removing some filters.</p></div>
  </div>
</div>

<footer>
  <div class="footer-grid">
    <div><span class="footer-logo">Erge<span>ly</span></span><p class="footer-tagline">The ergonomic chair database. Real specs, verified data, no sponsored rankings.</p><p class="footer-copy">© 2026 Ergely. Independent.</p></div>
    <div class="footer-col"><h4>Browse</h4><a href="/chairs/">All Chairs</a></div>
    <div class="footer-col"><h4>Tools</h4><a href="/tools/chair-size-finder/">Chair Size Finder</a><a href="/guides/">Guides</a></div>
    <div class="footer-col"><h4>About</h4><a href="/about/">About</a><a href="/about/methodology/">How We Rate</a><a href="/contact/">Contact</a></div>
  </div>
  <div class="footer-bottom"><span>Ergely is reader-supported. We may earn a referral fee at no cost to you.</span><span>Not medical advice.</span></div>
</footer>

<script>
  const state = { height:null, weight:null, budget:null, brand:null, material:null, headrest:false, depth:false, tilt:false };
  function toggleMenu() { document.getElementById('mobile-menu').classList.toggle('open'); }
  document.addEventListener('click', function(e) { const m=document.getElementById('mobile-menu'),h=document.querySelector('.hamburger'); if(!m.contains(e.target)&&!h.contains(e.target)) m.classList.remove('open'); });
  function toggleFilter(btn) { const b=btn.nextElementSibling,o=btn.getAttribute('aria-expanded')==='true'; btn.setAttribute('aria-expanded',String(!o)); b.classList.toggle('hidden',o); }
  function togglePill(btn,type) {
    const g=btn.closest('.pill-group'),w=btn.classList.contains('active');
    g.querySelectorAll('.pill').forEach(p=>p.classList.remove('active'));
    if(!w){btn.classList.add('active');state[type]=btn.dataset.value;}else{state[type]=null;}
    applyFilters();
  }
  function calcErgelyFitScore(h, w, card) {
    const hMin=parseFloat(card.dataset.heightMin)||null;
    const hMax=parseFloat(card.dataset.heightMax)||null;
    const wMax=parseFloat(card.dataset.weightMax)||null;
    const seatMin=parseFloat(card.dataset.seatMin)||null;
    const seatMax=parseFloat(card.dataset.seatMax)||null;
    const lumbar=card.dataset.lumbar||'none';
    const armrest=card.dataset.armrest||'none';
    const material=card.dataset.material||'';
    let scores={height:null,weight:null,seat:null,lumbar:null,armrest:null,comfort:null};
    // HEIGHT (40%)
    if(h&&hMin&&hMax){
      const margin=Math.max(0,Math.max(hMin-h,h-hMax));
      if(margin===0)scores.height=100;
      else if(margin<=3)scores.height=85;
      else if(margin<=6)scores.height=65;
      else if(margin<=10)scores.height=40;
      else scores.height=10;
    }
    // WEIGHT (10%)
    if(w&&wMax){
      const pct=w/wMax;
      if(pct<=0.7)scores.weight=100;
      else if(pct<=0.85)scores.weight=95;
      else if(pct<=0.95)scores.weight=80;
      else if(pct<=1.0)scores.weight=60;
      else scores.weight=0;
    }
    // SEAT HEIGHT SUITABILITY (15%) — ideal seat = h * 0.26
    if(h&&seatMin&&seatMax){
      const ideal=h*0.26;
      if(ideal>=seatMin&&ideal<=seatMax)scores.seat=100;
      else{const d=Math.min(Math.abs(ideal-seatMin),Math.abs(ideal-seatMax));scores.seat=d<=2?85:d<=4?65:40;}
    }
    // LUMBAR (15%)
    if(lumbar==='adjustable'||lumbar==='true')scores.lumbar=100;
    else if(lumbar==='fixed'||lumbar==='present')scores.lumbar=60;
    else scores.lumbar=20;
    // ARMREST (10%)
    if(armrest==='4D')scores.armrest=100;
    else if(armrest==='3D')scores.armrest=80;
    else if(armrest==='2D')scores.armrest=55;
    else if(armrest==='1D')scores.armrest=30;
    else scores.armrest=10;
    // LONG-SESSION COMFORT (10%)
    const mat=material.toLowerCase();
    if(mat.includes('mesh'))scores.comfort=100;
    else if(mat.includes('fabric')||mat.includes('softweave'))scores.comfort=85;
    else if(mat.includes('leather')&&!mat.includes('faux'))scores.comfort=75;
    else scores.comfort=60;
    // WEIGHTED TOTAL
    const weights={height:0.40,weight:0.10,seat:0.15,lumbar:0.15,armrest:0.10,comfort:0.10};
    let total=0,totalWeight=0;
    for(const[k,wt]of Object.entries(weights)){
      if(scores[k]!==null){total+=scores[k]*wt;totalWeight+=wt;}
    }
    const finalScore=totalWeight>0?Math.round(total/totalWeight):null;
    return{score:finalScore,scores};
  }
  function scoreToClass(s){
    if(s>=90)return'excellent';
    if(s>=75)return'good-match';
    if(s>=60)return'fair';
    return'limited';
  }
  function scoreToLabel(s){
    if(s>=90)return'Excellent Match';
    if(s>=75)return'Good Match';
    if(s>=60)return'Fair Match';
    return'Limited Match';
  }
  function applyFitFinder() {
    const h=parseFloat(document.getElementById('ff-height').value);
    const w=parseFloat(document.getElementById('ff-weight').value);
    state.height=h||null; state.weight=w||null;
    if(!h&&!w) return;
    const cards=document.querySelectorAll('.product-card');
    let excellent=0,good=0,fair=0,limited=0;
    cards.forEach(card=>{
      const badge=document.getElementById('badge-'+card.dataset.id);
      if(!badge) return;
      const {score}=calcErgelyFitScore(h,w,card);
      if(score===null){badge.className='fit-badge';return;}
      const cls=scoreToClass(score);
      const lbl=scoreToLabel(score);
      badge.className='fit-badge visible '+cls;
      badge.innerHTML='<span class="fit-badge-score">'+score+'/100</span><span class="fit-badge-match">'+lbl+'</span>';
      card.dataset.fitScore=score;
      if(cls==='excellent')excellent++;
      else if(cls==='good-match')good++;
      else if(cls==='fair')fair++;
      else limited++;
      const base=card.getAttribute('href').split('?')[0];
      const params=[];
      if(h)params.push('h='+h);
      if(w)params.push('w='+w);
      card.setAttribute('href',base+(params.length?'?'+params.join('&'):''));
    });
    const result=document.getElementById('ff-result');
    result.textContent=excellent+' Excellent, '+good+' Good, '+fair+' Fair, '+limited+' Limited match found.';
    result.classList.add('active');
    const hdr=document.getElementById('fit-score-header');
    const sub=document.getElementById('fit-score-sub');
    if(hdr&&sub){hdr.classList.add('visible');sub.textContent='Matched to your body: '+(h?h+' cm':'')+(h&&w?' • ':'')+(w?w+' kg':'');}
    applyFilters();
  }
  function applyFilters() {
    state.headrest=document.getElementById('tog-headrest').checked;
    state.depth=document.getElementById('tog-depth').checked;
    state.tilt=document.getElementById('tog-tilt').checked;
    const cards=document.querySelectorAll('.product-card');let visible=0;
    cards.forEach(card=>{
      let show=true;
      if(state.brand && card.dataset.brand!==state.brand) show=false;
      if(state.budget && card.dataset.budget!==state.budget) show=false;
      if(state.material && !card.dataset.material.toLowerCase().includes(state.material)) show=false;
      if(state.headrest && card.dataset.headrest!=='true') show=false;
      if(state.depth && card.dataset.depth!=='true') show=false;
      if(state.tilt && card.dataset.tilt!=='true') show=false;
      card.classList.toggle('hidden',!show);if(show)visible++;
    });
    document.getElementById('count').textContent=visible;
    document.getElementById('no-results').classList.toggle('visible',visible===0);
  }
  function applySort(v) {
    const g=document.getElementById('product-grid'),cards=Array.from(g.querySelectorAll('.product-card'));
    cards.sort((a,b)=>v==='price_asc'?parseFloat(a.dataset.price)-parseFloat(b.dataset.price):v==='price_desc'?parseFloat(b.dataset.price)-parseFloat(a.dataset.price):0);
    cards.forEach(c=>g.appendChild(c));
  }
  function resetAll() {
    state.height=null;state.weight=null;state.budget=null;state.brand=null;state.material=null;
    document.getElementById('ff-height').value='';
    document.getElementById('ff-weight').value='';
    document.getElementById('ff-result').classList.remove('active');
    document.getElementById('tog-headrest').checked=false;
    document.getElementById('tog-depth').checked=false;
    document.getElementById('tog-tilt').checked=false;
    document.querySelectorAll('.pill.active').forEach(p=>p.classList.remove('active'));
    document.querySelectorAll('.fit-badge').forEach(b=>{b.className='fit-badge';b.innerHTML='';});const hdr=document.getElementById('fit-score-header');if(hdr)hdr.classList.remove('visible');
    document.querySelectorAll('.product-card').forEach(c=>{c.classList.remove('hidden');delete c.dataset.fitScore;const base=c.getAttribute('href').split('?')[0];c.setAttribute('href',base);});
    document.getElementById('count').textContent=document.querySelectorAll('.product-card').length;
    document.getElementById('no-results').classList.remove('visible');
  }
</script>
