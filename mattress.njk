---
pagination:
  data: mattresses.mattresses
  size: 1
  alias: item
permalink: "mattresses/{{ item.id }}/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% set pageTitle = item.identity.brand + " " + item.identity.model + " Review — Mattress for Back Pain | Ergely" %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ item.editorial.best_for_summary }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://ergely.com/mattresses/{{ item.id }}/">
  <meta property="og:type" content="product">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:url" content="https://ergely.com/mattresses/{{ item.id }}/">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "{{ item.identity.brand }} {{ item.identity.model }}",
    "description": "{{ item.editorial.best_for_summary }}",
    "brand": { "@type": "Brand", "name": "{{ item.identity.brand }}" },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "USD",
      "price": "{{ item.identity.price_usd }}",
      "availability": "https://schema.org/InStock",
      "url": "{{ item.identity.product_url }}"
    }
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --black: #1B1B1B; --accent: #E05A2B; --white: #FFFFFF;
      --offwhite: #F7F7F5; --border: #E4E4E0; --muted: #6B6B6B;
      --green: #2A7D4F; --red: #C0392B; --font: 'Inter', system-ui, sans-serif;
    }
    body { font-family: var(--font); background: var(--white); color: var(--black); font-size: 15px; line-height: 1.6; }
    a { color: inherit; text-decoration: none; }
    nav { background: #fff; height: 56px; display: flex; align-items: center; padding: 0 32px; position: sticky; top: 0; z-index: 200; gap: 32px; border-bottom: 1px solid #e4e4e0; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    .logo { font-size: 19px; font-weight: 800; letter-spacing: -0.03em; color: #1B1B1B; flex-shrink: 0; }
    .logo span { color: #E05A2B; }
    .nav-links { display: flex; gap: 2px; flex: 1; }
    .nav-links a { color: #1B1B1B; font-size: 13px; font-weight: 500; padding: 5px 12px; border-radius: 5px; transition: color 0.12s, background 0.12s; white-space: nowrap; }
    .nav-links a:hover { color: #E05A2B; background: #fff5f2; }
    .nav-links a.active { color: #E05A2B; font-weight: 600; }
    .nav-links span.soon { color: #666; pointer-events: none; padding: 5px 12px; font-size: 13px; font-weight: 500; }
    .nav-right { margin-left: auto; display: flex; gap: 8px; }
    .nav-right a { color: #6B6B6B; font-size: 13px; font-weight: 500; padding: 5px 12px; border-radius: 5px; }
    .nav-right a:hover { color: #1B1B1B; }
    .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 4px; margin-left: auto; background: none; border: none; }
    .hamburger span { display: block; width: 22px; height: 2px; background: #1B1B1B; border-radius: 2px; }
    .mobile-menu { display: none; position: fixed; top: 56px; left: 0; right: 0; background: #fff; border-bottom: 1px solid #E4E4E0; padding: 12px 0; z-index: 199; box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
    .mobile-menu.open { display: block; }
    .mobile-menu a { display: block; padding: 12px 24px; font-size: 15px; font-weight: 500; color: #1B1B1B; border-bottom: 1px solid #F7F7F5; }
    .mobile-menu a.active { color: #E05A2B; font-weight: 600; }
    .mobile-menu span.soon { color: #aaa; pointer-events: none; display: block; padding: 12px 24px; font-size: 15px; border-bottom: 1px solid #F7F7F5; }
    .breadcrumb { padding: 12px 32px; font-size: 13px; color: var(--muted); max-width: 1100px; margin: 0 auto; }
    .breadcrumb a { color: var(--muted); }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb span { margin: 0 6px; }
    .product-page { max-width: 1100px; margin: 0 auto; padding: 24px 32px 64px; display: grid; grid-template-columns: 380px 1fr; gap: 48px; align-items: start; }
    .product-gallery { position: sticky; top: 76px; }
    .product-image-wrap { background: var(--offwhite); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; }
    .product-image-wrap img { width: 100%; height: 100%; object-fit: contain; padding: 16px; }
    .img-placeholder { color: var(--muted); font-size: 13px; text-align: center; }
    .price-box { margin-top: 16px; padding: 18px; border: 1px solid var(--border); border-radius: 10px; background: var(--offwhite); }
    .price-label { font-size: 12px; color: var(--muted); margin-bottom: 4px; }
    .price-value { font-size: 28px; font-weight: 800; color: var(--black); letter-spacing: -0.02em; }
    .btn-primary { display: block; width: 100%; margin-top: 12px; padding: 13px 20px; background: var(--accent); color: #fff; font-weight: 600; font-size: 14px; text-align: center; border-radius: 7px; transition: background 0.12s; }
    .btn-primary:hover { background: #c44e24; }
    .key-specs-list { margin-top: 16px; list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .key-specs-list li { display: flex; justify-content: space-between; font-size: 13px; padding: 8px 12px; background: var(--offwhite); border: 1px solid var(--border); border-radius: 6px; }
    .spec-label { color: var(--muted); }
    .spec-val { font-weight: 600; }
    .product-content { min-width: 0; }
    .product-brand { font-size: 12px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; }
    h1.product-title { font-size: 26px; font-weight: 800; line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 10px; }
    .product-summary { font-size: 14px; color: var(--muted); margin-bottom: 20px; line-height: 1.65; }
    .tag-list { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 24px; }
    .tag { font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 99px; background: var(--offwhite); border: 1px solid var(--border); color: var(--black); text-transform: uppercase; letter-spacing: 0.05em; }
    .fit-boxes { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 28px; }
    .fit-box { padding: 16px; border-radius: 10px; font-size: 13px; line-height: 1.55; }
    .fit-box-good { background: #EAF4EE; border: 1px solid #A8D5B5; }
    .fit-box-poor { background: #FAEAEA; border: 1px solid #E8A8A8; }
    .fit-box-title { font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; }
    .fit-box-good .fit-box-title { color: var(--green); }
    .fit-box-poor .fit-box-title { color: var(--red); }
    .sleep-positions { background: var(--offwhite); border: 1px solid var(--border); border-radius: 10px; padding: 16px; margin-bottom: 28px; }
    .sleep-positions h2 { font-size: 14px; font-weight: 700; margin-bottom: 10px; }
    .position-pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .position-pill { font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 99px; background: #fff; border: 1px solid var(--border); color: var(--muted); }
    .position-pill.good { background: #EAF4EE; border-color: #A8D5B5; color: var(--green); }
    .firmness-bar { background: var(--offwhite); border: 1px solid var(--border); border-radius: 10px; padding: 16px; margin-bottom: 28px; }
    .firmness-bar h2 { font-size: 14px; font-weight: 700; margin-bottom: 12px; }
    .firmness-track { height: 8px; background: linear-gradient(to right, #a8d5b5, #e0c96a, #e8a8a8); border-radius: 99px; position: relative; margin: 8px 0 4px; }
    .firmness-labels { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); }
    .firmness-marker { position: absolute; top: -4px; width: 16px; height: 16px; background: var(--accent); border-radius: 50%; border: 2px solid #fff; transform: translateX(-50%); box-shadow: 0 1px 4px rgba(0,0,0,0.2); }
    .specs-section { margin-bottom: 28px; }
    .specs-section h2 { font-size: 16px; font-weight: 700; margin-bottom: 14px; }
    .accordion-item { border: 1px solid var(--border); border-radius: 8px; margin-bottom: 6px; overflow: hidden; }
    .accordion-header { width: 100%; background: var(--offwhite); border: none; padding: 13px 16px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-family: var(--font); font-size: 14px; font-weight: 600; color: var(--black); text-align: left; }
    .accordion-header:hover { background: #ececea; }
    .accordion-arrow { font-size: 11px; transition: transform 0.2s; color: var(--muted); }
    .accordion-header[aria-expanded="true"] .accordion-arrow { transform: rotate(180deg); }
    .accordion-body { display: none; padding: 14px 16px; background: #fff; }
    .accordion-body.open { display: block; }
    .spec-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .spec-table tr { border-bottom: 1px solid var(--border); }
    .spec-table tr:last-child { border-bottom: none; }
    .spec-table td { padding: 8px 4px; }
    .spec-table td:first-child { color: var(--muted); width: 55%; }
    .spec-table td:last-child { font-weight: 500; text-align: right; }
    .related-section { margin-top: 40px; }
    .related-section h2 { font-size: 16px; font-weight: 700; margin-bottom: 14px; }
    .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .related-card { border: 1px solid var(--border); border-radius: 10px; padding: 14px; color: var(--black); transition: border-color 0.15s; background: var(--offwhite); display: block; }
    .related-card:hover { border-color: var(--accent); }
    .related-card-brand { font-size: 11px; color: var(--muted); font-weight: 700; text-transform: uppercase; margin-bottom: 2px; }
    .related-card-model { font-weight: 700; font-size: 13px; margin-bottom: 5px; }
    .related-card-summary { font-size: 12px; color: var(--muted); line-height: 1.45; }
    footer { background: #111; padding: 48px 32px 0; }
    .footer-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; padding-bottom: 48px; border-bottom: 1px solid #2a2a2a; }
    .footer-logo { font-size: 18px; font-weight: 800; color: #fff; margin-bottom: 12px; display: block; }
    .footer-logo span { color: #E05A2B; }
    .footer-tagline { font-size: 13px; color: #999; line-height: 1.6; margin-bottom: 16px; }
    .footer-copy { font-size: 12px; color: #666; }
    .footer-col h4 { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #aaa; margin-bottom: 16px; }
    .footer-col a { display: block; font-size: 13px; color: #999; margin-bottom: 9px; transition: color 0.12s; }
    .footer-col a:hover { color: #fff; }
    .footer-col span.soon { color: #888; pointer-events: none; display: block; font-size: 13px; margin-bottom: 9px; }
    .footer-bottom { max-width: 1100px; margin: 0 auto; padding: 18px 0; display: flex; justify-content: space-between; font-size: 12px; color: #666; gap: 24px; }
    @media (max-width: 900px) {
      .product-page { grid-template-columns: 1fr; gap: 24px; padding: 16px 20px 48px; }
      .product-gallery { position: static; }
      .fit-boxes { grid-template-columns: 1fr; }
      .related-grid { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    }
    @media (max-width: 600px) {
      nav { padding: 0 16px; }
      .nav-links, .nav-right { display: none; }
      .hamburger { display: flex; }
      .footer-grid { grid-template-columns: 1fr; gap: 28px; }
      .footer-bottom { flex-direction: column; text-align: center; }
    }
  </style>
</head>
<body>

<nav>
  <a href="/" class="logo">Erge<span>ly</span></a>
  <div class="nav-links">
    <a href="/chairs/">Chairs</a>
    <span class="soon">Standing Desks</span>
    <a href="/lumbar-supports/">Lumbar Supports</a>
    <a href="/cushions/">Cushions</a>
    <a href="/mattresses/" class="active">Mattresses</a>
  </div>
  <div class="nav-right">
    <a href="/guides/">Guides</a>
    <a href="/tools/chair-size-finder/">Size Finder</a>
  </div>
  <button class="hamburger" onclick="toggleMenu()" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="mobile-menu" id="mobile-menu">
  <a href="/chairs/">Chairs</a>
  <span class="soon">Standing Desks</span>
  <a href="/lumbar-supports/">Lumbar Supports</a>
  <a href="/cushions/">Cushions</a>
  <a href="/mattresses/" class="active">Mattresses</a>
  <a href="/guides/">Guides</a>
  <a href="/tools/chair-size-finder/">Size Finder</a>
</div>

<div class="breadcrumb">
  <a href="/">Home</a><span>›</span>
  <a href="/mattresses/">Mattresses</a><span>›</span>
  {{ item.identity.brand }} {{ item.identity.model }}
</div>

<div class="product-page">

  <aside class="product-gallery">
    <div class="product-image-wrap">
      {% if item.identity.image_url %}
        <img src="{{ item.identity.image_url }}" alt="{{ item.identity.brand }} {{ item.identity.model }} mattress for back pain" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
        <div class="img-placeholder" style="display:none;">Image not available</div>
      {% else %}
        <div class="img-placeholder">Image coming soon</div>
      {% endif %}
    </div>
    <div class="price-box">
      <div class="price-label">Price (approx.)</div>
      <div class="price-value">{% if item.identity.price_usd %}${{ item.identity.price_usd }}{% else %}—{% endif %}</div>
      <a href="{{ item.identity.product_url }}" target="_blank" rel="noopener sponsored" class="btn-primary">Check price at {{ item.identity.brand }} →</a>
    </div>
    <ul class="key-specs-list">
      <li><span class="spec-label">Type</span><span class="spec-val">{{ item.specs.mattress_type | replace("_", " ") | title if item.specs.mattress_type else "—" }}</span></li>
      <li><span class="spec-label">Firmness</span><span class="spec-val">{{ item.specs.firmness_level | replace("_", " ") | title if item.specs.firmness_level else "—" }}</span></li>
      <li><span class="spec-label">Thickness</span><span class="spec-val">{{ item.specs.thickness_cm ~ " cm" if item.specs.thickness_cm else "—" }}</span></li>
      <li><span class="spec-label">Motion isolation</span><span class="spec-val">{{ item.specs.motion_isolation | replace("_", " ") | title if item.specs.motion_isolation else "—" }}</span></li>
      <li><span class="spec-label">Sleep trial</span><span class="spec-val">{{ item.specs.sleep_trial_nights ~ " nights" if item.specs.sleep_trial_nights else "—" }}</span></li>
      <li><span class="spec-label">Warranty</span><span class="spec-val">{{ item.build.warranty_years ~ " yr" if item.build.warranty_years else "—" }}</span></li>
    </ul>
  </aside>

  <main class="product-content">
    <div class="product-brand">{{ item.identity.brand }}</div>
    <h1 class="product-title">{{ item.identity.model }}{% if item.identity.variant %} — {{ item.identity.variant }}{% endif %}</h1>
    <p class="product-summary">{{ item.editorial.best_for_summary }}</p>

    {% if item.editorial.tags %}
    <div class="tag-list">
      {% for tag in item.editorial.tags %}<span class="tag">{{ tag | replace("_", " ") }}</span>{% endfor %}
    </div>
    {% endif %}

    <div class="fit-boxes">
      <div class="fit-box fit-box-good">
        <div class="fit-box-title">✓ Best for</div>
        {{ item.editorial.best_for_summary }}
      </div>
      <div class="fit-box fit-box-poor">
        <div class="fit-box-title">✗ Not recommended for</div>
        {{ item.editorial.not_recommended_for if item.editorial.not_recommended_for else "No limitations noted." }}
      </div>
    </div>

    {% if item.fit.best_for_sleep_position and item.fit.best_for_sleep_position | length > 0 %}
    <div class="sleep-positions">
      <h2>Best sleep positions</h2>
      <div class="position-pills">
        {% set all_positions = ["back", "side", "stomach", "combo"] %}
        {% for pos in all_positions %}
          <span class="position-pill {% if pos in item.fit.best_for_sleep_position %}good{% endif %}">
            {{ pos | title }}
          </span>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if item.specs.firmness_scale %}
    <div class="firmness-bar">
      <h2>Firmness level</h2>
      <div class="firmness-track">
        <div class="firmness-marker" style="left: {{ (item.specs.firmness_scale / 10 * 100) }}%"></div>
      </div>
      <div class="firmness-labels">
        <span>Soft</span>
        <span>Medium</span>
        <span>Firm</span>
      </div>
    </div>
    {% endif %}

    <div class="specs-section">
      <h2>Full specifications</h2>

      <div class="accordion-item">
        <button class="accordion-header" aria-expanded="true" onclick="toggleAcc(this)">Construction <span class="accordion-arrow">▼</span></button>
        <div class="accordion-body open">
          <table class="spec-table">
            <tr><td>Mattress type</td><td>{{ item.specs.mattress_type | replace("_", " ") | title if item.specs.mattress_type else "—" }}</td></tr>
            <tr><td>Firmness</td><td>{{ item.specs.firmness_level | replace("_", " ") | title if item.specs.firmness_level else "—" }}</td></tr>
            <tr><td>Firmness (1–10)</td><td>{{ item.specs.firmness_scale if item.specs.firmness_scale else "—" }}</td></tr>
            <tr><td>Thickness</td><td>{{ item.specs.thickness_cm ~ " cm" if item.specs.thickness_cm else "—" }}</td></tr>
          </table>
        </div>
      </div>

      <div class="accordion-item">
        <button class="accordion-header" aria-expanded="false" onclick="toggleAcc(this)">Performance <span class="accordion-arrow">▼</span></button>
        <div class="accordion-body">
          <table class="spec-table">
            <tr><td>Motion isolation</td><td>{{ item.specs.motion_isolation | replace("_", " ") | title if item.specs.motion_isolation else "—" }}</td></tr>
            <tr><td>Edge support</td><td>{{ item.specs.edge_support | replace("_", " ") | title if item.specs.edge_support else "—" }}</td></tr>
            <tr><td>Cooling</td><td>{{ item.specs.cooling | replace("_", " ") | title if item.specs.cooling else "—" }}</td></tr>
          </table>
        </div>
      </div>

      <div class="accordion-item">
        <button class="accordion-header" aria-expanded="false" onclick="toggleAcc(this)">Trial, warranty & certifications <span class="accordion-arrow">▼</span></button>
        <div class="accordion-body">
          <table class="spec-table">
            <tr><td>Sleep trial</td><td>{{ item.specs.sleep_trial_nights ~ " nights" if item.specs.sleep_trial_nights else "—" }}</td></tr>
            <tr><td>Warranty</td><td>{{ item.build.warranty_years ~ " years" if item.build.warranty_years else "—" }}</td></tr>
            <tr><td>Certifications</td><td>{{ item.build.certifications | join(", ") if item.build.certifications | length > 0 else "None published" }}</td></tr>
            <tr><td>Available sizes</td><td>{{ item.specs.size_options | join(", ") if item.specs.size_options | length > 0 else "—" }}</td></tr>
          </table>
        </div>
      </div>
    </div>

    <div class="related-section">
      <h2>Similar mattresses</h2>
      <div class="related-grid">
        {% set relatedCount = 0 %}
        {% for other in mattresses.mattresses %}
          {% if other.id != item.id and relatedCount < 3 %}
            <a href="/mattresses/{{ other.id }}/" class="related-card">
              <div class="related-card-brand">{{ other.identity.brand }}</div>
              <div class="related-card-model">{{ other.identity.model }}</div>
              <div class="related-card-summary">{{ other.editorial.best_for_summary }}</div>
            </a>
            {% set relatedCount = relatedCount + 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </main>
</div>

<footer>
  <div class="footer-grid">
    <div>
      <span class="footer-logo">Erge<span>ly</span></span>
      <p class="footer-tagline">The ergonomic equipment database. Real specs, verified data, no sponsored rankings.</p>
      <p class="footer-copy">© 2026 Ergely. Independent. Not affiliated with any brand.</p>
    </div>
    <div class="footer-col">
      <h4>Categories</h4>
      <a href="/chairs/">Ergonomic Chairs</a>
      <span class="soon">Standing Desks</span>
      <a href="/lumbar-supports/">Lumbar Supports</a>
      <a href="/cushions/">Cushions</a>
      <a href="/mattresses/">Mattresses</a>
    </div>
    <div class="footer-col">
      <h4>Tools & Guides</h4>
      <a href="/tools/chair-size-finder/">Chair Size Finder</a>
      <a href="/guides/ergonomic-chair-sizing-guide/">Sizing Guide</a>
      <a href="/guides/what-is-lumbar-support/">What is Lumbar Support?</a>
    </div>
    <div class="footer-col">
      <h4>About</h4>
      <a href="/about/">About Ergely</a>
      <a href="/about/methodology/">How We Rate</a>
      <a href="/about/data-sources/">Data Sources</a>
      <a href="/contact/">Contact</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>Ergely is reader-supported. We may earn a referral fee at no cost to you.</span>
    <span>Not medical advice.</span>
  </div>
</footer>

<script>
  function toggleMenu() {
    document.getElementById('mobile-menu').classList.toggle('open');
  }
  document.addEventListener('click', function(e) {
    const menu = document.getElementById('mobile-menu');
    const hamburger = document.querySelector('.hamburger');
    if (!menu.contains(e.target) && !hamburger.contains(e.target)) menu.classList.remove('open');
  });
  function toggleAcc(btn) {
    const body = btn.nextElementSibling;
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isOpen));
    body.classList.toggle('open', !isOpen);
  }
</script>
</body>
</html>
