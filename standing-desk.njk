---
pagination:
  data: standing_desks.desks
  size: 1
  alias: desk
permalink: "standing-desks/{{ desk.id }}/index.html"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- set pageDesc -%}{{ desk.identity.brand }} {{ desk.identity.model }} standing desk. Best for {{ desk.editorial.best_for_summary }}.{% if desk.specs.height_min_cm %} Fits {{ desk.specs.height_min_cm }}–{{ desk.specs.height_max_cm }} cm.{% endif %}{% if desk.specs.weight_capacity_kg %} Up to {{ desk.specs.weight_capacity_kg }} kg.{% endif %}{% if desk.identity.price_usd %} From ${{ desk.identity.price_usd }}.{% endif %}{%- endset -%}
  <title>{{ desk.identity.brand }} {{ desk.identity.model }} Review — Standing Desk | Ergely</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://ergely.com/standing-desks/{{ desk.id }}/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --black:#1B1B1B;--accent:#E05A2B;--white:#FFFFFF;--offwhite:#F7F7F5;--border:#E4E4E0;--muted:#6B6B6B;--green:#2A7D4F;--red:#C0392B;--font:'Inter',system-ui,sans-serif; }
    body { font-family:var(--font);background:var(--white);color:var(--black);font-size:15px;line-height:1.6; }
    a { color:inherit;text-decoration:none; }
    nav { background:#fff;height:56px;display:flex;align-items:center;padding:0 32px;position:sticky;top:0;z-index:200;gap:32px;border-bottom:1px solid var(--border);box-shadow:0 1px 4px rgba(0,0,0,0.06); }
    .logo { font-size:19px;font-weight:800;letter-spacing:-0.03em;color:var(--black);flex-shrink:0; }
    .logo span { color:var(--accent); }
    .nav-links { display:flex;gap:2px;flex:1; }
    .nav-links a { color:var(--black);font-size:13px;font-weight:500;padding:5px 12px;border-radius:5px; }
    .nav-links a:hover { color:var(--accent);background:#fff5f2; }
    .nav-links a.active { color:var(--accent);font-weight:600; }
    .nav-right { margin-left:auto;display:flex;gap:8px; }
    .nav-right a { color:var(--muted);font-size:13px;font-weight:500;padding:5px 12px;border-radius:5px; }
    .hamburger { display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;margin-left:auto;background:none;border:none; }
    .hamburger span { display:block;width:22px;height:2px;background:var(--black);border-radius:2px; }
    .mobile-menu { display:none;position:fixed;top:56px;left:0;right:0;background:#fff;border-bottom:1px solid var(--border);padding:12px 0;z-index:199; }
    .mobile-menu.open { display:block; }
    .mobile-menu a { display:block;padding:12px 24px;font-size:15px;font-weight:500;color:var(--black);border-bottom:1px solid var(--offwhite); }
    .breadcrumb { max-width:1100px;margin:0 auto;padding:12px 32px;font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px; }
    .breadcrumb a { color:var(--muted); }
    .breadcrumb a:hover { color:var(--accent); }
    .product-wrap { max-width:1100px;margin:0 auto;padding:24px 32px 64px;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start; }
    .product-gallery { position:sticky;top:76px; }
    .product-image-wrap { background:#fff;border:1px solid var(--border);border-radius:12px;overflow:hidden;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;cursor:zoom-in;position:relative; }
    .product-image-wrap img { width:100%;height:100%;object-fit:cover;transition:transform 0.2s; }
    .product-image-wrap:hover img { transform:scale(1.03); }
    .zoom-hint { position:absolute;bottom:10px;right:12px;font-size:11px;color:var(--muted);background:rgba(255,255,255,0.9);padding:2px 8px;border-radius:99px;border:1px solid var(--border);pointer-events:none; }
    .img-placeholder { font-size:48px;color:var(--muted); }
    .lightbox { display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:1000;align-items:center;justify-content:center;cursor:zoom-out; }
    .lightbox.open { display:flex; }
    .lightbox img { max-width:90vw;max-height:90vh;object-fit:contain;border-radius:8px; }
    .lightbox-close { position:absolute;top:20px;right:24px;font-size:32px;color:#fff;cursor:pointer;background:none;border:none;font-family:var(--font); }
    .product-info { display:flex;flex-direction:column;gap:20px; }
    .product-brand { font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em; }
    .product-title { font-size:28px;font-weight:800;letter-spacing:-0.02em;line-height:1.2; }
    .product-summary { font-size:15px;color:var(--muted);line-height:1.6; }
    .editorial-grid { display:grid;grid-template-columns:1fr 1fr;gap:12px; }
    .editorial-box { border-radius:8px;padding:14px; }
    .editorial-box.best { background:#f0faf4;border:1px solid #c3e6d0; }
    .editorial-box.not { background:#fdf2f2;border:1px solid #f0c4c4; }
    .editorial-label { font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px; }
    .editorial-box.best .editorial-label { color:var(--green); }
    .editorial-box.not .editorial-label { color:var(--red); }
    .editorial-text { font-size:13px;line-height:1.5;color:var(--black); }
    .fit-checker { background:var(--offwhite);border:1px solid var(--border);border-radius:10px;padding:20px; }
    .fit-checker-title { font-size:14px;font-weight:700;margin-bottom:14px; }
    .fit-checker-inputs { display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px; }
    .fit-checker-field { display:flex;flex-direction:column;gap:4px; }
    .fit-checker-field label { font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em; }
    .fit-checker-field input { padding:8px 10px;border:1px solid var(--border);border-radius:6px;font-size:14px;font-family:var(--font);background:#fff; }
    .fit-checker-field input:focus { outline:2px solid var(--accent);border-color:transparent; }
    .btn-check { padding:10px 20px;background:var(--accent);color:#fff;font-weight:700;font-size:13px;border:none;border-radius:6px;cursor:pointer;font-family:var(--font); }
    .fit-result { display:none;margin-top:12px;padding:12px 14px;border-radius:8px;font-size:13px;line-height:1.5; }
    .fit-result.good { background:#f0faf4;border:1px solid #c3e6d0;color:var(--green); }
    .fit-result.poor { background:#fdf2f2;border:1px solid #f0c4c4;color:var(--red); }
    .fit-result.active { display:block; }
    .fit-result a { color:var(--muted);font-size:12px;display:block;margin-top:6px; }
    .fit-score-box { background:#fff;border:1.5px solid var(--accent);border-radius:10px;padding:16px;display:none; }
    .fit-score-box.active { display:block; }
    .fit-score-title { font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--accent);margin-bottom:8px; }
    .fit-score-number { font-size:36px;font-weight:800;letter-spacing:-0.03em;color:var(--black);line-height:1; }
    .fit-score-label { font-size:13px;font-weight:600;color:var(--muted);margin-top:4px; }
    .fit-score-breakdown { margin-top:12px;display:flex;flex-direction:column;gap:6px; }
    .fit-score-row { display:flex;justify-content:space-between;font-size:12px; }
    .fit-score-row span:first-child { color:var(--muted); }
    .fit-score-row span:last-child { font-weight:600;color:var(--black); }
    .price-box { background:var(--white);border:1px solid var(--border);border-radius:10px;padding:16px; }
    .price-label { font-size:12px;color:var(--muted);margin-bottom:4px; }
    .price-value { font-size:28px;font-weight:800;letter-spacing:-0.03em;margin-bottom:12px; }
    .btn-check-price { display:block;width:100%;padding:12px;background:var(--accent);color:#fff;font-weight:700;font-size:14px;border:none;border-radius:8px;cursor:pointer;font-family:var(--font);text-align:center; }
    .btn-check-price:hover { background:#c44e24; }
    .quick-specs { display:grid;grid-template-columns:1fr 1fr;gap:8px; }
    .quick-spec { display:flex;justify-content:space-between;align-items:center;font-size:13px;padding:8px 0;border-bottom:1px solid var(--border); }
    .quick-spec:last-child { border-bottom:none; }
    .quick-spec-label { color:var(--muted); }
    .quick-spec-value { font-weight:600; }
    .specs-section { max-width:1100px;margin:0 auto;padding:0 32px 64px; }
    .specs-title { font-size:18px;font-weight:800;margin-bottom:20px; }
    .specs-group { border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:12px; }
    .specs-group-header { padding:14px 16px;background:var(--offwhite);font-size:13px;font-weight:700;cursor:pointer;display:flex;justify-content:space-between;align-items:center;border:none;width:100%;font-family:var(--font);text-align:left; }
    .specs-group-body { padding:0 16px; }
    .specs-group-body.hidden { display:none; }
    .spec-row { display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);font-size:13px; }
    .spec-row:last-child { border-bottom:none; }
    .spec-label { color:var(--muted); }
    .spec-value { font-weight:600;text-align:right; }
    footer { background:#111;padding:48px 32px 0; }
    .footer-grid { max-width:1100px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px;padding-bottom:48px;border-bottom:1px solid #2a2a2a; }
    .footer-logo { font-size:18px;font-weight:800;color:#fff;margin-bottom:12px;display:block; }
    .footer-logo span { color:var(--accent); }
    .footer-tagline { font-size:13px;color:#999;line-height:1.6;margin-bottom:16px; }
    .footer-copy { font-size:12px;color:#666; }
    .footer-col h4 { font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#aaa;margin-bottom:16px; }
    .footer-col a { display:block;font-size:13px;color:#999;margin-bottom:9px; }
    .footer-col a:hover { color:#fff; }
    .footer-bottom { max-width:1100px;margin:0 auto;padding:18px 0;display:flex;justify-content:space-between;font-size:12px;color:#666; }
    @media(max-width:900px){.product-wrap{grid-template-columns:1fr;gap:24px;}.product-gallery{position:static;}.editorial-grid{grid-template-columns:1fr;}.quick-specs{grid-template-columns:1fr;}.footer-grid{grid-template-columns:1fr 1fr;gap:32px;}}
    @media(max-width:600px){nav{padding:0 16px;}.nav-links,.nav-right{display:none;}.hamburger{display:flex;}.breadcrumb,.product-wrap,.specs-section{padding-left:16px;padding-right:16px;}.fit-checker-inputs{grid-template-columns:1fr;}.footer-grid{grid-template-columns:1fr;}.footer-bottom{flex-direction:column;}}
  </style>
</head>
<body>
<nav>
  <a href="/" class="logo">Erge<span>ly</span></a>
  <div class="nav-links">
    <a href="/standing-desks/" class="active">Standing Desks</a>
  </div>
  <div class="nav-right">
    <a href="/guides/">Guides</a>
    <a href="/tools/desk-size-finder/">Size Finder</a>
  </div>
  <button class="hamburger" onclick="toggleMenu()" aria-label="Menu"><span></span><span></span><span></span></button>
</nav>
<div class="mobile-menu" id="mobile-menu">
  <a href="/standing-desks/" class="active">Standing Desks</a>
</div>

<div class="breadcrumb">
  <a href="/">Home</a> ›
  <a href="/standing-desks/">Standing Desks</a> ›
  <span>{{ desk.identity.brand }} {{ desk.identity.model }}</span>
</div>

<div class="product-wrap">
  <aside class="product-gallery">
    <div class="product-image-wrap" onclick="openLightbox(this)">
      {% if desk.identity.image_url %}
        <img src="{{ desk.identity.image_url }}" alt="{{ desk.identity.brand }} {{ desk.identity.model }}" loading="eager">
        <span class="zoom-hint">🔍 Click to enlarge</span>
      {% else %}
        <div class="img-placeholder">🖥️</div>
      {% endif %}
    </div>
    <div class="lightbox" id="lightbox" onclick="closeLightbox()">
      <button class="lightbox-close" onclick="closeLightbox()">✕</button>
      <img id="lightbox-img" src="" alt="">
    </div>

    <div style="margin-top:16px;">
      <div class="price-box">
        <div class="price-label">Price (approx.)</div>
        <div class="price-value">{% if desk.identity.price_usd %}${{ desk.identity.price_usd }}{% else %}—{% endif %}</div>
        <a href="{{ desk.identity.product_url }}" target="_blank" rel="noopener sponsored" class="btn-check-price">
          Check price at {{ desk.identity.brand }} →
        </a>
      </div>
    </div>

    <div style="margin-top:12px;">
      <div class="quick-specs">
        {% if desk.specs.height_min_cm and desk.specs.height_max_cm %}
        <div class="quick-spec"><span class="quick-spec-label">Height range</span><span class="quick-spec-value">{{ desk.specs.height_min_cm }}–{{ desk.specs.height_max_cm }} cm</span></div>
        {% endif %}
        {% if desk.specs.weight_capacity_kg %}
        <div class="quick-spec"><span class="quick-spec-label">Max weight</span><span class="quick-spec-value">{{ desk.specs.weight_capacity_kg }} kg</span></div>
        {% endif %}
        {% if desk.specs.motors %}
        <div class="quick-spec"><span class="quick-spec-label">Motors</span><span class="quick-spec-value">{{ desk.specs.motors }} motor{% if desk.specs.motors > 1 %}s{% endif %}</span></div>
        {% endif %}
        {% if desk.specs.memory_presets %}
        <div class="quick-spec"><span class="quick-spec-label">Memory presets</span><span class="quick-spec-value">{{ desk.specs.memory_presets }}</span></div>
        {% endif %}
        {% if desk.specs.warranty_years %}
        <div class="quick-spec"><span class="quick-spec-label">Warranty</span><span class="quick-spec-value">{{ desk.specs.warranty_years }} yr</span></div>
        {% endif %}
        {% if desk.specs.anti_collision %}
        <div class="quick-spec"><span class="quick-spec-label">Anti-collision</span><span class="quick-spec-value">Yes</span></div>
        {% endif %}
      </div>
    </div>
  </aside>

  <div class="product-info">
    <div>
      <div class="product-brand">{{ desk.identity.brand }}</div>
      <h1 class="product-title">{{ desk.identity.model }}</h1>
      <p class="product-summary">{{ desk.editorial.best_for_summary }}</p>
    </div>

    <div class="editorial-grid">
      <div class="editorial-box best">
        <div class="editorial-label">✓ Best for</div>
        <div class="editorial-text">{{ desk.editorial.best_for_summary }}</div>
      </div>
      <div class="editorial-box not">
        <div class="editorial-label">✕ Not recommended for</div>
        <div class="editorial-text">{{ desk.editorial.not_recommended_for }}</div>
      </div>
    </div>

    <!-- FIT CHECKER -->
    <div class="fit-checker">
      <div class="fit-checker-title">Does this desk fit you?</div>
      <div class="fit-checker-inputs">
        <div class="fit-checker-field">
          <label for="fc-height">Your height (cm)</label>
          <input type="number" id="fc-height" placeholder="e.g. 175" min="140" max="220">
        </div>
      </div>
      <button class="btn-check" onclick="checkFit()">Check fit</button>
      <div class="fit-result" id="fit-result"></div>
    </div>

    <!-- FIT SCORE BREAKDOWN -->
    <div class="fit-score-box" id="fit-score-box">
      <div class="fit-score-title">Ergely Fit Score™</div>
      <div class="fit-score-number" id="fit-score-number">—</div>
      <div class="fit-score-label" id="fit-score-label"></div>
      <div class="fit-score-breakdown">
        <div class="fit-score-row"><span>Sitting height compatibility</span><span id="score-sit">—</span></div>
        <div class="fit-score-row"><span>Standing height compatibility</span><span id="score-stand">—</span></div>
        <div class="fit-score-row"><span>Overall score</span><span id="score-total">—</span></div>
      </div>
    </div>
  </div>
</div>

<!-- FULL SPECS -->
<div class="specs-section">
  <div class="specs-title">Full specifications</div>

  <div class="specs-group">
    <button class="specs-group-header" onclick="toggleSpecs(this)">Height & Size <span>▲</span></button>
    <div class="specs-group-body">
      {% if desk.specs.height_min_cm and desk.specs.height_max_cm %}
      <div class="spec-row"><span class="spec-label">Height range</span><span class="spec-value">{{ desk.specs.height_min_cm }}–{{ desk.specs.height_max_cm }} cm</span></div>
      {% endif %}
      {% if desk.specs.desktop_width_cm %}
      <div class="spec-row"><span class="spec-label">Desktop width</span><span class="spec-value">{{ desk.specs.desktop_width_cm }} cm</span></div>
      {% endif %}
      {% if desk.specs.desktop_depth_cm %}
      <div class="spec-row"><span class="spec-label">Desktop depth</span><span class="spec-value">{{ desk.specs.desktop_depth_cm }} cm</span></div>
      {% endif %}
      {% if desk.specs.leg_stages %}
      <div class="spec-row"><span class="spec-label">Leg stages</span><span class="spec-value">{{ desk.specs.leg_stages }}-stage</span></div>
      {% endif %}
    </div>
  </div>

  <div class="specs-group">
    <button class="specs-group-header" onclick="toggleSpecs(this)">Motor & Controls <span>▾</span></button>
    <div class="specs-group-body hidden">
      {% if desk.specs.motors %}
      <div class="spec-row"><span class="spec-label">Motors</span><span class="spec-value">{{ desk.specs.motors }} motor{% if desk.specs.motors > 1 %}s{% endif %}</span></div>
      {% endif %}
      {% if desk.specs.memory_presets %}
      <div class="spec-row"><span class="spec-label">Memory presets</span><span class="spec-value">{{ desk.specs.memory_presets }}</span></div>
      {% endif %}
      {% if desk.specs.anti_collision %}
      <div class="spec-row"><span class="spec-label">Anti-collision</span><span class="spec-value">Yes</span></div>
      {% endif %}
    </div>
  </div>

  <div class="specs-group">
    <button class="specs-group-header" onclick="toggleSpecs(this)">Build <span>▾</span></button>
    <div class="specs-group-body hidden">
      {% if desk.specs.weight_capacity_kg %}
      <div class="spec-row"><span class="spec-label">Weight capacity</span><span class="spec-value">{{ desk.specs.weight_capacity_kg }} kg</span></div>
      {% endif %}
      {% if desk.specs.frame_material %}
      <div class="spec-row"><span class="spec-label">Frame material</span><span class="spec-value">{{ desk.specs.frame_material }}</span></div>
      {% endif %}
      {% if desk.specs.warranty_years %}
      <div class="spec-row"><span class="spec-label">Warranty</span><span class="spec-value">{{ desk.specs.warranty_years }} years</span></div>
      {% endif %}
    </div>
  </div>
</div>

<footer>
  <div class="footer-grid">
    <div><span class="footer-logo">Erge<span>ly</span></span><p class="footer-tagline">The ergonomic compatibility platform. Real specs, verified data, no sponsored rankings.</p><p class="footer-copy">© 2026 Ergely. Independent.</p></div>
    <div class="footer-col"><h4>Browse</h4><a href="/standing-desks/">Standing Desks</a></div>
    <div class="footer-col"><h4>Tools</h4><a href="/tools/desk-size-finder/">Desk Size Finder</a><a href="/guides/">Guides</a></div>
    <div class="footer-col"><h4>About</h4><a href="/about/">About</a><a href="/contact/">Contact</a></div>
  </div>
  <div class="footer-bottom"><span>Ergely is reader-supported. We may earn a referral fee at no cost to you.</span><span>Not medical advice.</span></div>
</footer>

<script>
  const DESK_HEIGHT_MIN = {{ desk.specs.height_min_cm if desk.specs.height_min_cm else 'null' }};
  const DESK_HEIGHT_MAX = {{ desk.specs.height_max_cm if desk.specs.height_max_cm else 'null' }};

  function toggleMenu() { document.getElementById('mobile-menu').classList.toggle('open'); }
  function openLightbox(wrap) {
    const img=wrap.querySelector('img');
    if(!img) return;
    document.getElementById('lightbox-img').src=img.src;
    document.getElementById('lightbox').classList.add('open');
    document.body.style.overflow='hidden';
  }
  function closeLightbox() { document.getElementById('lightbox').classList.remove('open'); document.body.style.overflow=''; }
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeLightbox(); });

  function toggleSpecs(btn) {
    const body=btn.nextElementSibling;
    const arrow=btn.querySelector('span');
    const hidden=body.classList.toggle('hidden');
    arrow.textContent=hidden?'▾':'▲';
  }

  function calcFitScore(h) {
    if(!DESK_HEIGHT_MIN||!DESK_HEIGHT_MAX) return null;
    const idealSit=h*0.43;
    const idealStand=h*0.60;
    let sitScore=100;
    if(idealSit<DESK_HEIGHT_MIN){const d=DESK_HEIGHT_MIN-idealSit;sitScore=d<=2?90:d<=5?70:d<=10?45:10;}
    else if(idealSit>DESK_HEIGHT_MAX){const d=idealSit-DESK_HEIGHT_MAX;sitScore=d<=2?90:d<=5?70:d<=10?45:10;}
    let standScore=100;
    if(idealStand<DESK_HEIGHT_MIN){const d=DESK_HEIGHT_MIN-idealStand;standScore=d<=2?90:d<=5?70:d<=10?45:10;}
    else if(idealStand>DESK_HEIGHT_MAX){const d=idealStand-DESK_HEIGHT_MAX;standScore=d<=2?90:d<=5?70:d<=10?45:10;}
    const total=Math.round(sitScore*0.60+standScore*0.40);
    return{total,sitScore:Math.round(sitScore),standScore:Math.round(standScore)};
  }

  function scoreToLabel(s){if(s>=90)return'Excellent Match';if(s>=75)return'Good Match';if(s>=60)return'Fair Match';return'Limited Match';}

  function checkFit() {
    const h=parseFloat(document.getElementById('fc-height').value);
    if(!h||h<100||h>250){alert('Please enter a valid height between 100 and 250 cm.');return;}
    const result=document.getElementById('fit-result');
    const scoreBox=document.getElementById('fit-score-box');

    if(!DESK_HEIGHT_MIN||!DESK_HEIGHT_MAX){
      result.className='fit-result active poor';
      result.innerHTML='Height data not available for this desk.';
      return;
    }

    const idealSit=Math.round(h*0.43);
    const idealStand=Math.round(h*0.60);
    const scores=calcFitScore(h);
    const label=scoreToLabel(scores.total);

    const sitOk=idealSit>=DESK_HEIGHT_MIN&&idealSit<=DESK_HEIGHT_MAX;
    const standOk=idealStand>=DESK_HEIGHT_MIN&&idealStand<=DESK_HEIGHT_MAX;

    if(sitOk&&standOk){
      result.className='fit-result active good';
      result.innerHTML='<strong>Good fit.</strong> Your ideal sitting height ('+idealSit+' cm) and standing height ('+idealStand+' cm) both fall within this desk\'s range of '+DESK_HEIGHT_MIN+'–'+DESK_HEIGHT_MAX+' cm.<br><a href="/standing-desks/?h='+h+'">← Check another desk</a>';
    } else if(sitOk||standOk){
      result.className='fit-result active good';
      result.innerHTML='<strong>Partial fit.</strong> '+(sitOk?'Sitting height ('+idealSit+' cm) fits':'Standing height ('+idealStand+' cm) fits')+' within this desk\'s range of '+DESK_HEIGHT_MIN+'–'+DESK_HEIGHT_MAX+' cm.<br><a href="/standing-desks/?h='+h+'">← Check another desk</a>';
    } else {
      result.className='fit-result active poor';
      result.innerHTML='<strong>Poor fit.</strong> Your ideal sitting height ('+idealSit+' cm) and standing height ('+idealStand+' cm) are outside this desk\'s range of '+DESK_HEIGHT_MIN+'–'+DESK_HEIGHT_MAX+' cm.<br><a href="/standing-desks/?h='+h+'">← Find a better match</a>';
    }

    // Score breakdown
    scoreBox.classList.add('active');
    document.getElementById('fit-score-number').textContent=scores.total+'/100';
    document.getElementById('fit-score-label').textContent=label;
    document.getElementById('score-sit').textContent=scores.sitScore+'/100';
    document.getElementById('score-stand').textContent=scores.standScore+'/100';
    document.getElementById('score-total').textContent=scores.total+'/100';
  }

  // Pre-fill from URL params
  const params=new URLSearchParams(window.location.search);
  const hParam=params.get('h');
  if(hParam){document.getElementById('fc-height').value=hParam;checkFit();}
</script>
</body>
</html>
